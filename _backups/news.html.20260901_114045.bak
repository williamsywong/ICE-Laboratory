<div class="page-hero" style="position: relative; background-image: linear-gradient(rgba(10, 22, 40, 0.55), rgba(10, 22, 40, 0.75)), url('images/News/SLIPS_Drainage.gif'); background-size: cover, cover; background-position: center center, center center; background-repeat: no-repeat, no-repeat;">
  <div class="page-hero-inner">
    <span class="section-tag" style="color: var(--ice-bright); position: relative;">Latest from the ICE Laboratory at the University of sydney</span>
    <h1 class="" style="position: relative;">News</h1>
    <p class="" style="position: relative;">Publications, awards, grants, events, and milestones.</p>
  </div>
</div>

<div class="stats-strip" id="newsStats"><div class="stat-item"><span class="stat-num" style="position: relative;">2</span><span class="stat-label" style="position: relative;">Total items</span></div></div>

<div class="controls-bar">
  <label>Filter:</label>
  <button class="filter-btn active" data-tag="all">All</button>
  <button class="filter-btn" data-tag="Publication" style="display: none;">Publications</button>
  <button class="filter-btn" data-tag="Award" style="display: none;">Awards</button>
  <button class="filter-btn" data-tag="Grant" style="display: none;">Grants</button>
  <button class="filter-btn" data-tag="Recruitment">Recruitment</button>
  <button class="filter-btn" data-tag="Event" style="display: none;">Events</button>
  <button class="filter-btn" data-tag="Milestone">Milestones</button>
  <button class="filter-btn" data-tag="Welcome" style="display: none;">Welcome</button>
</div>

<div class="news-wrap">
  <div class="news-grid" id="newsGrid">
        <div class="news-card featured" data-news-key="2026-08-25-phd-positions-open" style="position: relative;">
          <div class="news-card-img-placeholder" style="background:linear-gradient(135deg,var(--ice-blue),var(--ice-bright))"></div>
          <div class="news-card-body">
            <div class="news-card-meta">
              <span class="news-tag-pill" style="background: rgb(240, 235, 250); color: rgb(107, 63, 160); position: relative;">Recruitment</span>
              <span class="news-date-str" style="position: relative;">25 Aug 2026</span>
            </div>
            <h3 class="news-card-title" style="position: relative;">PhD positions open</h3>
            <p class="news-card-body-text" style="position: relative;">We are recruiting motivated PhD students with backgrounds in chemical engineering, materials science, chemistry, and applied physics. <br> <br><b> 2 Fully-funded positions available. </b><br> <br> If you are interested in joining the group, please send us a brief introduction outlining your<b> (1) research interests</b> (<b><u>max 1 page</u></b>) together with your <b>(2)&nbsp;CVs </b>(<b><u>max 2 pages</u></b>) and <b>(3)&nbsp;latest academic transcript</b>. This allows us to assess potential research alignment and discuss suitable funding routes. Formal admission to the PhD program is handled through the University of Sydney. Details regarding eligibility, application procedures and English-language requirements can be found in this link: <a href="https://www.sydney.edu.au/courses/courses/pr/doctor-of-philosophy-engineering.html" target="_blank" rel="noopener" class="" style="position: relative;">Doctor of Philosophy (Engineering)</a>.</p>
            <a class="news-card-link" href="mailto:william.swong@sydney.edu.au" target="_blank" rel="noopener" style="position: relative;">Express interest</a>
          </div>
        </div>
        <div class="news-card" data-news-key="2026-08-01-the-interfacial-chemical-engineering-ice" style="position: relative;">
          <div class="news-card-img-placeholder" style="background:linear-gradient(135deg,var(--ice-blue),var(--ice-bright))"></div>
          <div class="news-card-body">
            <div class="news-card-meta">
              <span class="news-tag-pill" style="background: rgb(230, 250, 243); color: rgb(10, 102, 64); position: relative;">Milestone</span>
              <span class="news-date-str" style="position: relative;">1 Aug 2026</span>
            </div>
            <h3 class="news-card-title" style="position: relative;">The Interfacial Chemical Engineering (ICE) Laboratory is established at the University of Sydney</h3>
            <p class="news-card-body-text" style="position: relative;">William S. Y. Wong joins the School of Chemical &amp; Biomolecular Engineering as Lecturer and Group Leader.</p>
            
          </div>
        </div></div>
</div>

<footer>
  <span class="footer-left" style="position: relative; width: 562px; height: 12px;">© 2026 ICE Laboratory · Interfacial Chemical Engineering for Next-Generation Processes</span>
  <span class="footer-visitors" data-cms-skip="1"><img src="https://api.visitorbadge.io/api/visitors?path=ice-group-usyd-website&amp;label=Visitors&amp;countColor=%235bb8e8&amp;style=flat-square&amp;labelColor=%230a1628" alt="Visitor count"></span>
  <span class="footer-usyd" style="position: relative;">The University of Sydney</span>
</footer>

<script src="data/news.js"></script>
<script>
  let activeTag = 'all';

  function formatDate(str) {
    const d = new Date(str + 'T00:00:00');
    return d.toLocaleDateString('en-AU', { day: 'numeric', month: 'short', year: 'numeric' });
  }

  function tagStyle(tag) {
    const c = NEWS_TAG_COLORS[tag] || { bg: '#f0f0f0', color: '#555' };
    return `background:${c.bg};color:${c.color}`;
  }

  // Deterministic key for a news item (date + slugified title) — must
  // exactly match newsKeyFor() in editor.html, since that's how a card
  // edited in the Site Editor gets matched back to this entry when saving.
  function slugify(str) {
    return String(str).toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '').slice(0, 40);
  }
  function newsKeyFor(item) {
    return `${item.date}-${slugify(item.title)}`;
  }

  // Full years elapsed since 1 Feb 2027 (when the lab's "years running" count
  // starts) — negative/zero before that date, which renderStats hides.
  // Parses "YYYY-MM-DD" as a LOCAL date (not UTC) — new Date("YYYY-MM-DD")
  // parses as UTC midnight, which can silently shift a day in either
  // direction depending on the browser's timezone. This avoids that.
  function parseLocalDate(str) {
    const [y, m, d] = String(str).split('-').map(Number);
    return new Date(y, (m || 1) - 1, d || 1);
  }

  // Full years elapsed since NEWS_START_DATE (data/news.js) — negative/zero
  // before that date, which renderStats hides. Deliberately NOT based on the
  // real-world clock: "now" here is the most recent date among the NEWS
  // entries below, so this stays fully deterministic and adding a
  // further-dated NEWS entry is enough to preview a "future" state of the
  // site (change NEWS_START_DATE in data/news.js to move the start point).
  function yearsSinceStart() {
    if (typeof NEWS_START_DATE !== 'string' || !NEWS.length) return 0;
    const start = parseLocalDate(NEWS_START_DATE);
    if (isNaN(start.getTime())) return 0;

    const latestMs = Math.max(...NEWS.map(n => parseLocalDate(n.date).getTime()));
    const now = new Date(latestMs);
    if (isNaN(now.getTime())) return 0;

    let years = now.getFullYear() - start.getFullYear();
    const hadAnniversaryThisYear =
      now.getMonth() > start.getMonth() ||
      (now.getMonth() === start.getMonth() && now.getDate() >= start.getDate());
    if (!hadAnniversaryThisYear) years--;
    return Math.max(0, years);
  }

  function renderStats() {
    const pubs   = NEWS.filter(n => n.tag === 'Publication').length;
    const awards = NEWS.filter(n => n.tag === 'Award' || n.tag === 'Grant').length;
    const total  = NEWS.length;
    const years  = yearsSinceStart();

    // Zero-value stats are hidden entirely rather than shown as "0".
    const stats = [
      { num: total,  label: 'Total items' },
      { num: pubs,   label: 'Publications' },
      { num: awards, label: 'Awards &amp; Grants' },
      { num: years,  label: 'Years' },
    ].filter(s => s.num > 0);

    document.getElementById('newsStats').innerHTML = stats.map(s =>
      `<div class="stat-item"><span class="stat-num">${s.num}</span><span class="stat-label">${s.label}</span></div>`
    ).join('');
  }

  function renderGrid() {
    let items = [...NEWS].sort((a, b) => b.date.localeCompare(a.date));
    if (activeTag !== 'all') items = items.filter(n => n.tag === activeTag);

    const grid = document.getElementById('newsGrid');
    if (!items.length) {
      grid.innerHTML = `<div class="no-results"><span>📰</span>No news items match this filter.</div>`;
      return;
    }

    grid.innerHTML = items.map((item, i) => {
      const featured = (i === 0 && activeTag === 'all') ? 'featured' : '';
      const imgEl = item.image
        ? `<img class="news-card-img" src="images/News/${item.image}" alt="${item.title}">`
        : `<div class="news-card-img-placeholder" style="background:linear-gradient(135deg,var(--ice-blue),var(--ice-bright))"></div>`;
      const linkEl = item.link
        ? `<a class="news-card-link" href="${item.link}" target="_blank" rel="noopener">${item.linkText}</a>`
        : '';
      return `
        <div class="news-card ${featured}" data-news-key="${newsKeyFor(item)}">
          ${imgEl}
          <div class="news-card-body">
            <div class="news-card-meta">
              <span class="news-tag-pill" style="${tagStyle(item.tag)}">${item.tag}</span>
              <span class="news-date-str">${formatDate(item.date)}</span>
            </div>
            <h3 class="news-card-title">${item.title}</h3>
            <p class="news-card-body-text">${item.body}</p>
            ${linkEl}
          </div>
        </div>`;
    }).join('');
  }

  document.querySelectorAll('.filter-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeTag = btn.dataset.tag;
      renderGrid();
    });
  });

  // Only show a filter button when at least one NEWS entry actually has that
  // tag ("All" shows as long as there's any news item at all).
  function renderFilterButtons() {
    document.querySelectorAll('.filter-btn').forEach(btn => {
      const tag = btn.dataset.tag;
      const hasEntries = tag === 'all' ? NEWS.length > 0 : NEWS.some(n => n.tag === tag);
      btn.style.display = hasEntries ? '' : 'none';
    });
  }

  renderFilterButtons();
  renderStats();
  renderGrid();
</script>














</body>
</html>