<script src="data/gallery.js"></script>
<script>
  // Tile data now lives in data/gallery.js (GALLERY / GALLERY_CATEGORIES / GALLERY_SIZES) —
  // edit that file to add, remove, resize, or reorder tiles.

  let activeCat = 'all';

  function tileHTML(item) {
    const sizeCfg = GALLERY_SIZES[item.size] || GALLERY_SIZES.small;
    const inner = item.file
      ? `<img src="images/Gallery/${item.file}" alt="${item.caption}" loading="lazy" style="${sizeCfg.minHeight ? 'min-height:'+sizeCfg.minHeight+'px;object-fit:cover;' : ''}">`
      : `<div class="mtile-ph" style="min-height:${sizeCfg.minHeight}px"><span class="mi">${item.icon || '📷'}</span></div>`;
    const linkBadge = item.link ? `<div class="mtile-link-badge">↗</div>` : '';
    const tag = item.link ? 'a' : 'div';
    const href = item.link ? `href="${item.link}" target="_blank" rel="noopener"` : '';
    return `<${tag} class="mtile${sizeCfg.wide ? ' wide' : ''}" ${href}>
      ${inner}
      ${linkBadge}
      <div class="mtile-overlay"><span class="mtile-cap">${item.caption}</span></div>
    </${tag}>`;
  }

  function render() {
    const filtered = activeCat === 'all' ? GALLERY : GALLERY.filter(g => g.category === activeCat);
    document.getElementById('mosaic').innerHTML = filtered.map(tileHTML).join('');
  }

  document.querySelectorAll('.filter-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeCat = btn.dataset.cat;
      render();
    });
  });

  render();
</script>















</body>
</html>