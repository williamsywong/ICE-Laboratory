<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ICE Group · University of Sydney</title>
  <link rel="stylesheet" href="css/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
  <style>


    .page-hero {
      background: var(--ice-deep);
      padding: 5rem 3rem 4rem;
      position: relative; overflow: hidden;
    }
    .page-hero::before {
      content: ''; position: absolute; inset: 0;
      background: radial-gradient(ellipse 60% 60% at 10% 60%, rgba(91,184,232,0.07) 0%, transparent 70%);
    }
    .page-hero-inner { max-width: 1100px; margin: 0 auto; position: relative; z-index: 1; }
    .page-hero h1 {
      font-family: 'Playfair Display', serif;
      font-size: 2.8rem; font-weight: 400; color: white; margin-bottom: 0.75rem;
    }
    .page-hero p { color: rgba(255,255,255,0.5); font-size: 15px; max-width: 480px; }

    /* Controls */
    .controls-bar {
      background: white; border-bottom: 1px solid var(--border);
      padding: 1rem 3rem; display: flex; align-items: center;
      gap: 0.75rem; flex-wrap: wrap;
      position: sticky; top: 64px; z-index: 50;
    }
    .controls-bar label { font-size: 11px; letter-spacing: 1px; text-transform: uppercase; color: var(--text-muted); font-weight: 500; }
    .filter-btn {
      background: transparent; border: 1px solid var(--border);
      border-radius: 20px; padding: 0.3rem 0.9rem;
      font-size: 12px; color: var(--text-muted); cursor: pointer;
      transition: all 0.18s; font-family: 'DM Sans', sans-serif;
    }
    .filter-btn:hover { border-color: var(--ice-blue); color: var(--ice-blue); }
    .filter-btn.active { background: var(--ice-blue); border-color: var(--ice-blue); color: white; font-weight: 500; }
    .sep { width: 1px; height: 24px; background: var(--border); margin: 0 0.25rem; }

    /* Gallery wrap */
    .gallery-wrap { max-width: 1100px; margin: 0 auto; padding: 0 3rem 5rem; }

    /* Year group */
    .year-section { margin-top: 3.5rem; }
    .year-header {
      display: flex; align-items: center; gap: 1rem;
      border-bottom: 2px solid var(--ice-pale);
      padding-bottom: 0.5rem; margin-bottom: 1.5rem;
    }
    .year-label {
      font-family: 'Playfair Display', serif;
      font-size: 1.4rem; font-weight: 400; color: var(--ice-deep);
    }
    .year-count { font-size: 12px; color: var(--text-muted); }

    /* Masonry grid */
    .masonry {
      columns: 4;
      column-gap: 1rem;
    }
    .masonry-item {
      break-inside: avoid;
      margin-bottom: 1rem;
      position: relative;
      overflow: hidden;
      border-radius: 10px;
      cursor: pointer;
      background: var(--ice-pale);
    }
    .masonry-item.wide { column-span: all; }

    .masonry-item img {
      width: 100%; display: block;
      border-radius: 10px;
      transition: transform 0.3s;
    }
    .masonry-item:hover img { transform: scale(1.03); }

    /* Placeholder tiles (shown when no real image) */
    .photo-placeholder {
      width: 100%; border-radius: 10px;
      background: linear-gradient(135deg, var(--ice-mid) 0%, var(--ice-blue) 100%);
      display: flex; flex-direction: column;
      align-items: center; justify-content: center;
      color: rgba(255,255,255,0.6); font-size: 12px;
      text-align: center; padding: 1.5rem;
      min-height: 140px;
      transition: transform 0.3s;
    }
    .masonry-item:hover .photo-placeholder { transform: scale(1.02); }
    .photo-placeholder .ph-icon { font-size: 2rem; margin-bottom: 0.5rem; opacity: 0.5; }
    .photo-placeholder .ph-label { font-size: 11px; letter-spacing: 0.5px; opacity: 0.6; }

    /* Overlay caption */
    .masonry-item .caption-overlay {
      position: absolute; bottom: 0; left: 0; right: 0;
      background: linear-gradient(to top, rgba(10,22,40,0.85) 0%, transparent 100%);
      padding: 2.5rem 1rem 0.85rem;
      opacity: 0; transition: opacity 0.25s;
      border-radius: 0 0 10px 10px;
    }
    .masonry-item:hover .caption-overlay { opacity: 1; }
    .caption-text { font-size: 12px; color: white; line-height: 1.4; }
    .caption-cat {
      font-size: 10px; font-weight: 500; letter-spacing: 1px;
      text-transform: uppercase; color: var(--ice-bright);
      display: block; margin-bottom: 3px;
    }

    /* Empty state */
    .empty-state { text-align: center; padding: 4rem 2rem; color: var(--text-muted); }
    .empty-state span { display: block; font-size: 3rem; margin-bottom: 1rem; opacity: 0.3; }

    /* Upload tip */
    .upload-tip {
      background: var(--ice-frost); border: 1px dashed var(--border);
      border-radius: 10px; padding: 1.25rem 1.5rem;
      margin-top: 3rem; font-size: 13px; color: var(--text-muted);
      display: flex; gap: 1rem; align-items: flex-start;
    }
    .upload-tip strong { color: var(--ice-blue); }

    /* Lightbox */
    .lightbox {
      display: none; position: fixed; inset: 0; z-index: 1000;
      background: rgba(5, 13, 26, 0.95);
      align-items: center; justify-content: center;
      flex-direction: column; gap: 1rem;
    }
    .lightbox.open { display: flex; }
    .lightbox img { max-width: 90vw; max-height: 80vh; border-radius: 8px; object-fit: contain; }
    .lightbox-placeholder {
      max-width: 600px; width: 90vw; border-radius: 8px;
      background: linear-gradient(135deg, var(--ice-mid), var(--ice-blue));
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      padding: 4rem 3rem; text-align: center; color: white;
    }
    .lightbox-placeholder .ph-icon { font-size: 3rem; margin-bottom: 1rem; opacity: 0.4; }
    .lightbox-caption { color: rgba(255,255,255,0.8); font-size: 14px; text-align: center; max-width: 560px; }
    .lightbox-close {
      position: fixed; top: 1.5rem; right: 1.5rem;
      width: 40px; height: 40px; border-radius: 50%;
      background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2);
      color: white; font-size: 18px; cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      transition: background 0.2s;
    }
    .lightbox-close:hover { background: rgba(255,255,255,0.2); }
    .lightbox-nav {
      display: flex; gap: 1rem; margin-top: 0.5rem;
    }
    .lightbox-nav button {
      background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2);
      color: white; padding: 0.4rem 1.1rem; border-radius: 6px;
      cursor: pointer; font-size: 13px; font-family: 'DM Sans', sans-serif;
      transition: background 0.2s;
    }
    .lightbox-nav button:hover { background: rgba(255,255,255,0.2); }

  
  
  </style>
<link rel="icon" type="image/png" href="images/Branding/favicon.png">
</head>
<body>















<nav>
  <div class="nav-logo">
    <div class="nav-emblem" style="position: relative; background-image: url('images/Branding/ICE_Logo.png'); background-size: contain; background-position: center center; background-repeat: no-repeat;"></div>
    <a href="index.html" style="text-decoration:none">
      <span class="nav-name" style="position: relative;">ICE Laboratory · University of Sydney</span>
    </a>
  </div>
  <button class="nav-toggle" aria-label="Toggle menu" aria-expanded="false" onclick="const n=this.closest('nav'); n.classList.toggle('nav-open'); this.setAttribute('aria-expanded', n.classList.contains('nav-open'));">
    <span></span><span></span><span></span>
  </button>
  <ul class="nav-links">
    <li data-page="research" class="" style="position: relative;"><a href="index.html#research">Research</a></li>
    <li data-page="abstracts" class="" style="position: relative;"><a href="abstracts.html">Abstracts</a></li>
    <li data-page="gallery" class="" style="position: relative;"><a href="gallery.html">Gallery</a></li>
    <li data-page="publications" class="" style="position: relative;"><a href="publications.html">Publications</a></li>
    <li data-page="people" class="" style="position: relative;"><a href="people.html">People</a></li>
    <li data-page="alumni" class="" style="position: relative;"><a href="alumni.html">Alumni</a></li>
    <li data-page="news" class="" style="position: relative;"><a href="news.html">News</a></li>
    <li data-page="photos" class="" style="position: relative;"><a href="photos.html" class="active">Photos</a></li>
    <li data-page="join" class="" style="position: relative;"><a href="index.html#contact">Join Us</a></li>
  </ul>
</nav>

<div class="page-hero" style="position: relative; background-image: linear-gradient(rgba(10, 22, 40, 0.55), rgba(10, 22, 40, 0.75)), url('images/Photos/hero-cropped.png-cropped.png-cropped.png'); background-size: cover, cover; background-position: center center, center center; background-repeat: no-repeat, no-repeat;">
  <div class="page-hero-inner">
    <span class="section-tag" style="color: var(--ice-bright); position: relative;">Gallery of laboratory</span>
    <h1 class="" style="position: relative;">Photos</h1>
    <p class="" style="position: relative;">Group life, lab work, conferences, and events.</p>
  </div>
</div>

<div class="controls-bar">
  <label>Category:</label>
  <div id="categoryFilters" style="display: inline-flex; gap: 0.5rem;">
  <button class="filter-btn active" data-cat="all">All</button>
  <button class="filter-btn" data-cat="group">
      👥 Group
    </button><button class="filter-btn" data-cat="lab">
      🔬 Lab
    </button><button class="filter-btn" data-cat="event">
      🎉 Events
    </button><button class="filter-btn" data-cat="conference">
      🎤 Conferences
    </button>
</div>

  <div class="sep"></div>

  <label>Year:</label>
  <div id="yearFilters" style="display: inline-flex; gap: 0.5rem;">
  <button class="filter-btn active" data-year="all">All years</button>
  <button class="filter-btn" data-year="2026">2026</button>
</div>
</div>

<div class="gallery-wrap" id="galleryWrap">
    <div class="year-section">
      <div class="year-header">
        <span class="year-label" style="position: relative;">2026</span>
        <span class="year-count" style="position: relative;">1 photo</span>
      </div>
      <div class="masonry">
      <div class="masonry-item wide" style="position: relative;">
        <img src="images/Photos/Australia_Coin.jpg?v=Australia_Coin.jpg?v=Australia_Coin.jpg%3Fv%3DAustralia_Coin.jpg" alt="Interfacial Chemical Engineering (ICE) Laboratory Established, University of Sydney, 2026" loading="lazy" style="">
        <div class="caption-overlay">
          <span class="caption-cat" style="position: relative;">🎉 Events</span>
          <span class="caption-text" style="position: relative;">Interfacial Chemical Engineering (ICE) Laboratory Established, University of Sydney, 2026</span>
        </div>
      </div></div>
    </div></div>

<div class="lightbox" id="lightbox">
  <button class="lightbox-close" id="lbClose">✕</button>
  <div id="lbContent"></div>
  <p class="lightbox-caption" id="lbCaption"></p>
  <div class="lightbox-nav">
    <button id="lbPrev">← Prev</button>
    <button id="lbNext">Next →</button>
  </div>
</div>

<footer>
  <span class="footer-left" style="position: relative; width: 562px; height: 12px;">© 2026 ICE Laboratory · Interfacial Chemical Engineering for Next-Generation Processes</span>
  <span class="footer-visitors" data-cms-skip="1"><img src="https://api.visitorbadge.io/api/visitors?path=ice-group-usyd-website&amp;label=Visitors&amp;countColor=%235bb8e8&amp;style=flat-square&amp;labelColor=%230a1628" alt="Visitor count"></span>
  <span class="footer-usyd" style="position: relative;">The University of Sydney</span>
</footer>

<script src="data/photos.js"></script>
<script>
  let activeCat  = 'all';
  let activeYear = 'all';
  let lightboxItems = [];
  let lbIndex = 0;

// Generate category filters from PHOTO_CATEGORIES
const cf = document.getElementById('categoryFilters');

cf.innerHTML = `
  <button class="filter-btn active" data-cat="all">All</button>
  ${Object.entries(PHOTO_CATEGORIES).map(([key, config]) =>
    `<button class="filter-btn" data-cat="${key}">
      ${config.icon} ${config.label}
    </button>`
  ).join('')}
`;

cf.querySelectorAll('.filter-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    cf.querySelectorAll('.filter-btn')
      .forEach(b => b.classList.remove('active'));

    btn.classList.add('active');
    activeCat = btn.dataset.cat;
    render();
  });
});


// Generate year filters automatically from PHOTOS
const yf = document.getElementById('yearFilters');

const years = [...new Set(
  PHOTOS
    .map(p => p.year)
    .filter(Boolean)
)].sort((a, b) => b - a);

yf.innerHTML = `
  <button class="filter-btn active" data-year="all">All years</button>
  ${years.map(year =>
    `<button class="filter-btn" data-year="${year}">${year}</button>`
  ).join('')}
`;

yf.querySelectorAll('.filter-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    yf.querySelectorAll('.filter-btn')
      .forEach(b => b.classList.remove('active'));

    btn.classList.add('active');
    activeYear = btn.dataset.year;
    render();
  });
});

  function catIcon(cat) {
    return (PHOTO_CATEGORIES[cat] || {}).icon || '📷';
  }
  function catLabel(cat) {
    return (PHOTO_CATEGORIES[cat] || {}).label || cat;
  }

  // A tile is a "placeholder" only when no real filename is given —
  // NOT based on whether the filename happens to contain the word
  // "placeholder" (a real uploaded photo can be named anything).
  function isPlaceholder(file) {
    return !file;
  }

  function tileHtml(item, idx) {
    const wideClass = item.wide ? ' wide' : '';
    const imgContent = isPlaceholder(item.file)
      ? `<div class="photo-placeholder" style="min-height:${item.tall ? '260px' : '140px'}">
           <span class="ph-icon">${catIcon(item.category)}</span>
           <span class="ph-label">${catLabel(item.category)} · ${item.year}</span>
         </div>`
      : `<img src="images/Photos/${item.file}?v=${encodeURIComponent(item.file)}" alt="${item.caption}" loading="lazy"
              style="${item.tall ? 'min-height:260px;object-fit:cover;' : ''}">`;
    return `
      <div class="masonry-item${wideClass}" data-idx="${idx}">
        ${imgContent}
        <div class="caption-overlay">
          <span class="caption-cat">${catIcon(item.category)} ${catLabel(item.category)}</span>
          <span class="caption-text">${item.caption}</span>
        </div>
      </div>`;
  }

  function render() {
    let filtered = PHOTOS.filter(p => {
      const catOk  = activeCat  === 'all' || p.category === activeCat;
      const yearOk = activeYear === 'all' || String(p.year) === activeYear;
      return catOk && yearOk;
    });

    const wrap = document.getElementById('galleryWrap');

    if (!filtered.length) {
      wrap.innerHTML = `<div class="empty-state"><span>📷</span>No photos yet!<br></div>`;
      lightboxItems = [];
      return;
    }

    const byYear = {};
    filtered.forEach((p, i) => {
      (byYear[p.year] = byYear[p.year] || []).push({ ...p, _filtered_idx: i });
    });
    lightboxItems = filtered;

    const sortedYears = Object.keys(byYear).sort((a,b) => b - a);
    wrap.innerHTML = sortedYears.map(yr => {
       const items = byYear[yr];
       const tiles = items.map(p => tileHtml(p, p._filtered_idx)).join('');
    return `
    <div class="year-section">
      <div class="year-header">
        <span class="year-label">${yr}</span>
        <span class="year-count">${items.length} photo${items.length > 1 ? 's' : ''}</span>
      </div>
      <div class="masonry">${tiles}</div>
    </div>`;
}).join('');

    wrap.querySelectorAll('.masonry-item').forEach(el => {
      el.addEventListener('click', () => openLightbox(parseInt(el.dataset.idx)));
    });
  }

  function openLightbox(idx) {
    lbIndex = idx;
    showLbItem();
    document.getElementById('lightbox').classList.add('open');
  }

  function showLbItem() {
    const item = lightboxItems[lbIndex];
    const content = document.getElementById('lbContent');
    if (isPlaceholder(item.file)) {
      content.innerHTML = `<div class="lightbox-placeholder">
        <span class="ph-icon">${catIcon(item.category)}</span>
        <p style="color:rgba(255,255,255,0.5);font-size:13px">Photo coming soon</p>
      </div>`;
    } else {
      content.innerHTML = `<img src="images/Photos/${item.file}" alt="${item.caption}">`;
    }
    document.getElementById('lbCaption').textContent = item.caption;
  }

  document.getElementById('lbClose').addEventListener('click', () => {
    document.getElementById('lightbox').classList.remove('open');
  });
  document.getElementById('lightbox').addEventListener('click', e => {
    if (e.target === document.getElementById('lightbox'))
      document.getElementById('lightbox').classList.remove('open');
  });
  document.getElementById('lbPrev').addEventListener('click', () => {
    lbIndex = (lbIndex - 1 + lightboxItems.length) % lightboxItems.length;
    showLbItem();
  });
  document.getElementById('lbNext').addEventListener('click', () => {
    lbIndex = (lbIndex + 1) % lightboxItems.length;
    showLbItem();
  });
  document.addEventListener('keydown', e => {
    if (!document.getElementById('lightbox').classList.contains('open')) return;
    if (e.key === 'ArrowLeft')  { lbIndex = (lbIndex - 1 + lightboxItems.length) % lightboxItems.length; showLbItem(); }
    if (e.key === 'ArrowRight') { lbIndex = (lbIndex + 1) % lightboxItems.length; showLbItem(); }
    if (e.key === 'Escape')     document.getElementById('lightbox').classList.remove('open');
  });

  render();
</script>














</body>
</html>