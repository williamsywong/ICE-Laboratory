<!-- MAIN CONTENT -->
<div class="people-wrap">

  <!-- ── PI PROFILE ── -->
  <span class="section-tag" style="position: relative;">Principal Investigator</span>
  <h2 class="section-title" style="margin-bottom: 2rem; position: relative;">Group Leader</h2>

  <div class="pi-card">
    <div class="pi-header">
      <div class="pi-photo-col">
        <div class="pi-avatar" style="position: relative; background-image: url('images/Headshots/People-WW.jpg-cropped.png-cropped.png'); background-size: cover; background-position: center center;"></div>
