<!-- FOOTER -->
<footer>
  <span class="footer-left" style="position: relative; width: 562px; height: 12px;">© 2026 ICE Laboratory · Interfacial Chemical Engineering for Next-Generation Processes</span>
  <span class="footer-visitors" data-cms-skip="1"><img src="https://api.visitorbadge.io/api/visitors?path=ice-group-usyd-website&amp;label=Visitors&amp;countColor=%235bb8e8&amp;style=flat-square&amp;labelColor=%230a1628" alt="Visitor count"></span>
  <span class="footer-usyd" style="position: relative;">The University of Sydney</span>
</footer>

<script src="data/people.js"></script>
<script src="data/team.js"></script>
<script>
  // ── PI profile tabs (About / Education / Awards & Grants / Patents /
  // Industry) — rendered from data/people.js. Edit that file's PI_ABOUT,
  // PI_EDUCATION, PI_AWARDS, PI_PATENTS, and PI_INDUSTRY to update them.

  function renderAbout(d) {
    const bioHTML = d.bio.map(p => `<p>${p}</p>`).join('\n            ');
    const interestsHTML = d.interests.map(t => `<span class="interest-tag">${t}</span>`).join('\n                ');
    const infoHTML = d.info.map(row => {
      const val = row.link ? `<a href="${row.link}"${row.link.startsWith('http') ? ' target="_blank"' : ''}>${row.value}</a>` : row.value;
      return `
            <div class="info-row">
              <div class="info-icon">${row.icon}</div>
              <div>
                <span class="info-label">${row.label}</span>
                <span class="info-val">${val}</span>
              </div>
            </div>`;
    }).join('');

    return `
        <div class="about-grid">
          <div class="about-text">
            ${bioHTML}
            <div>
              <p style="font-size: 12px; color: var(--text-muted); margin-bottom: 0.5rem; margin-top: 1rem; text-transform: uppercase; letter-spacing: 1px; font-weight: 500;">Research Interests</p>
              <div class="interests-wrap">
                ${interestsHTML}
              </div>
            </div>
          </div>
          <div class="info-list">${infoHTML}
          </div>
        </div>`;
  }

  function renderEducation(list) {
    const itemsHTML = list.map(item => `
          <div class="timeline-item">
            <div class="tl-dot" style="font-size:10px">${item.dot}</div>
            <div class="tl-body">
              <p class="tl-year">${item.year}</p>
              <p class="tl-degree">${item.degree}</p>
              <p class="tl-inst">${item.institution}</p>
              <p class="tl-detail">${item.detail}</p>
            </div>
          </div>`).join('');
    return `
        <div class="timeline">${itemsHTML}
        </div>`;
  }

  function renderAwards(list) {
    const itemsHTML = list.map(a => `
          <div class="award-item">
            <span class="award-year">${a.year}</span>
            <div class="award-body">
              <p class="award-name">${a.name}${a.pi ? ' <span class="award-pi">PI</span>' : ''}</p>
              ${a.detail ? `<p class="award-detail">${a.detail}</p>` : ''}
            </div>
          </div>`).join('');
    return `
        <div class="awards-list">${itemsHTML}
        </div>`;
  }

  function renderPatents(list) {
    return list.map(p => `
        <div class="patent-item">
          <span class="patent-id">${p.id}</span>
          <div>
            <p class="patent-title">${p.title}</p>
            <p class="patent-authors">${p.authors}</p>
          </div>
        </div>`).join('');
  }

  function renderIndustry(d) {
    const cardsHTML = d.partners.map(p => `
          <div class="industry-card">
            <p class="industry-name">${p.name}</p>
            <p class="industry-country">${p.country}</p>
            <p class="industry-topic">${p.topic}</p>
          </div>`).join('');
    return `
        <p class="subsec-lead">${d.lead}</p>
        <div class="industry-grid">${cardsHTML}
        </div>`;
  }

  document.getElementById('tab-about').innerHTML = renderAbout(PI_ABOUT);
  document.getElementById('tab-education').innerHTML = renderEducation(PI_EDUCATION);
  document.getElementById('tab-awards').innerHTML = renderAwards(PI_AWARDS);
  document.getElementById('tab-patents').innerHTML = renderPatents(PI_PATENTS);
  document.getElementById('tab-industry').innerHTML = renderIndustry(PI_INDUSTRY);
</script>
<script>
  // Team roster now lives in data/team.js (TEAM array) — shared with index.html —
  // edit that one file to add/remove/reorder team members or open positions.
  function memberCardHTML(m) {
    if (m.open) {
      return `<div class="member-card" style="border: 1px dashed var(--border); background: var(--ice-frost);">
        <div class="member-avatar" style="background:linear-gradient(135deg,#d4eaf7,#a8c8e8); font-size: 1.4rem;">+</div>
        <p class="member-name" style="color: var(--text-muted);">${m.role}</p>
        <p class="member-role"><a href="${m.link || 'index.html#contact'}" style="color: var(--ice-blue);">${m.linkText || 'Apply now →'}</a></p>
      </div>`;
    }
    const avatarStyle = m.photo
      ? `background:url('images/Headshots/${m.photo}') center center / cover;`
      : `background:${m.color || 'linear-gradient(135deg,#5bb8e8,#1a3a5c)'};`;
    return `<div class="member-card"${m.lead ? ' style="border-left: 3px solid var(--ice-bright);"' : ''}>
      <div class="member-avatar" style="${avatarStyle}">${m.photo ? '' : (m.initials || '')}</div>
      <p class="member-name">${m.name}</p>
      <p class="member-role">${m.role}</p>
    </div>`;
  }
  document.getElementById('teamGridPeople').innerHTML = TEAM.map(memberCardHTML).join('');

  // Tab switching
  document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const tab = btn.dataset.tab;
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
      btn.classList.add('active');
      document.getElementById('tab-' + tab).classList.add('active');
    });
  });
</script>







</body>
</html>