<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ICE Group · University of Sydney</title>
  <link rel="stylesheet" href="css/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="css/style.css">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=DM+Sans:wght@300;400;500&display=swap">
  <link rel="stylesheet" href="css/style.css">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=DM+Sans:wght@300;400;500&display=swap">
  <link rel="stylesheet" href="css/style.css">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=DM+Sans:wght@300;400;500&display=swap">
  <link rel="stylesheet" href="css/style.css">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=DM+Sans:wght@300;400;500&display=swap">
  <link rel="stylesheet" href="css/style.css">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=DM+Sans:wght@300;400;500&display=swap">
  <style>







    /* ---- PAGE HERO ---- */
    .page-hero {
      background: var(--ice-deep);
      padding: 5rem 3rem 4rem;
      position: relative; overflow: hidden;
    }
    .page-hero::before {
      content: ''; position: absolute; inset: 0;
      background: radial-gradient(ellipse 55% 70% at 90% 40%, rgba(91,184,232,0.08) 0%, transparent 70%);
    }
    .page-hero-inner { max-width: 1100px; margin: 0 auto; position: relative; z-index: 1; }
    .page-hero h1 {
      font-family: 'Playfair Display', serif;
      font-size: 2.8rem; font-weight: 400; color: white; margin-bottom: 0.75rem;
    }
    .page-hero p { color: rgba(255,255,255,0.5); font-size: 15px; max-width: 500px; }

    /* ---- MAIN LAYOUT ---- */
    .people-wrap { max-width: 1100px; margin: 0 auto; padding: 4rem 3rem 5rem; }

    /* ---- PI PROFILE ---- */
    .pi-card {
      background: white;
      border: 1px solid var(--border);
      border-radius: 16px;
      overflow: hidden;
      margin-bottom: 4rem;
      box-shadow: 0 4px 24px rgba(10,22,40,0.06);
    }
    .pi-header {
      background: linear-gradient(135deg, var(--ice-deep) 0%, var(--ice-mid) 100%);
      padding: 2.5rem 3rem;
      display: flex; gap: 2.5rem; align-items: flex-start;
      position: relative; overflow: hidden;
    }
    .pi-header::before {
      content: ''; position: absolute; inset: 0;
      background: radial-gradient(ellipse 60% 80% at 100% 50%, rgba(91,184,232,0.1) 0%, transparent 60%);
    }
    .pi-avatar {
      width: 100px; height: 100px; border-radius: 50%; flex-shrink: 0;
      background: linear-gradient(135deg, var(--ice-bright), var(--ice-blue));
      display: flex; align-items: center; justify-content: center;
      font-family: 'Playfair Display', serif; font-size: 2rem;
      color: white; font-weight: 600;
      border: 3px solid rgba(91,184,232,0.4);
      position: relative; z-index: 1;
    }
    .pi-photo-col {
      display: flex; flex-direction: column; align-items: center; gap: 0.7rem;
      flex-shrink: 0; position: relative; z-index: 1;
    }
    .pi-cv-link {
      font-size: 11px; font-weight: 500; color: var(--ice-bright);
      text-decoration: none; text-align: center; white-space: nowrap;
      border: 1px solid rgba(91,184,232,0.4); border-radius: 20px;
      padding: 4px 12px; background: rgba(91,184,232,0.08);
      transition: background 0.15s, border-color 0.15s;
    }
    .pi-cv-link:hover { background: rgba(91,184,232,0.18); border-color: var(--ice-bright); }
    .pi-meta { position: relative; z-index: 1; }
    .pi-name {
      font-family: 'Playfair Display', serif;
      font-size: 1.8rem; font-weight: 600; color: white;
      margin-bottom: 0.3rem;
    }
    .pi-title { font-size: 14px; color: var(--ice-bright); margin-bottom: 0.3rem; font-weight: 500; }
    .pi-dept { font-size: 13px; color: rgba(255,255,255,0.55); margin-bottom: 1.25rem; }
    .pi-badges { display: flex; gap: 0.6rem; flex-wrap: wrap; }
    .badge {
      font-size: 11px; font-weight: 500; letter-spacing: 0.5px;
      padding: 4px 12px; border-radius: 20px;
      border: 1px solid rgba(91,184,232,0.3);
      color: rgba(255,255,255,0.7);
    }
    .badge-link {
      font-size: 11px; font-weight: 500; letter-spacing: 0.5px;
      padding: 4px 12px; border-radius: 20px;
      border: 1px solid rgba(91,184,232,0.4);
      color: var(--ice-bright); text-decoration: none;
      transition: background 0.2s;
    }
    .badge-link:hover { background: rgba(91,184,232,0.15); }

    .social-icons { display: flex; align-items: center; gap: 0.55rem; margin-top: 0.9rem; flex-wrap: wrap; }
    .social-icon {
      display: flex; align-items: center; justify-content: center;
      transition: transform 0.15s, filter 0.15s;
    }
    .social-icon:hover { transform: translateY(-3px); }
    .social-icon img {
      height: 22px; width: auto; display: block;
    }

    /* ---- PI BODY TABS ---- */
    .pi-body { padding: 0; }
    .tab-nav {
      display: flex; gap: 0; border-bottom: 1px solid var(--border);
      padding: 0 2.5rem;
    }
    .tab-btn {
      font-size: 12px; font-weight: 500; letter-spacing: 0.5px;
      text-transform: uppercase; color: var(--text-muted);
      padding: 1rem 1.25rem; border: none; background: none;
      cursor: pointer; border-bottom: 2px solid transparent;
      margin-bottom: -1px; transition: color 0.2s, border-color 0.2s;
      font-family: 'DM Sans', sans-serif;
    }
    .tab-btn:hover { color: var(--ice-blue); }
    .tab-btn.active { color: var(--ice-blue); border-bottom-color: var(--ice-blue); }
    .tab-panel { display: none; padding: 2.5rem; }
    .tab-panel.active { display: block; }

    /* ---- ABOUT ---- */
    .about-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2.5rem; }
    .about-text p {
      font-size: 14px; color: var(--text-body); line-height: 1.8;
      margin-bottom: 1rem;
    }
    .about-text p:last-child { margin-bottom: 0; }
    .info-list { display: flex; flex-direction: column; gap: 1rem; }
    .info-row { display: flex; gap: 1rem; align-items: flex-start; }
    .info-icon {
      width: 34px; height: 34px; flex-shrink: 0;
      background: var(--ice-frost); border-radius: 8px;
      display: flex; align-items: center; justify-content: center;
      font-size: 15px;
    }
    .info-label { font-size: 10px; letter-spacing: 1.5px; text-transform: uppercase; color: var(--text-muted); display: block; margin-bottom: 2px; }
    .info-val { font-size: 13px; color: var(--text-body); }
    .info-val a { color: var(--ice-blue); text-decoration: none; }
    .info-val a:hover { text-decoration: underline; }

    /* ---- INTERESTS ---- */
    .interests-wrap { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 1.25rem; }
    .interest-tag {
      background: var(--ice-frost); border: 1px solid var(--border);
      border-radius: 6px; padding: 5px 12px;
      font-size: 12.5px; color: var(--text-muted);
    }

    /* ---- EDUCATION and EXPERIENCE ---- */
    .timeline { display: flex; flex-direction: column; gap: 0; }
    .timeline-item {
      display: flex; gap: 1.5rem;
      padding-bottom: 1.75rem; position: relative;
    }
    .timeline-item:not(:last-child)::before {
      content: ''; position: absolute;
      left: 18px; top: 36px; bottom: 0;
      width: 1px; background: var(--border);
    }
    .tl-dot {
      width: 36px; height: 36px; flex-shrink: 0;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--ice-bright), var(--ice-blue));
      display: flex; align-items: center; justify-content: center;
      font-size: 13px; color: white; font-weight: 600;
      position: relative; z-index: 1;
    }
    .tl-body {}
    .tl-year { font-size: 11px; color: var(--text-muted); letter-spacing: 0.5px; margin-bottom: 2px; }
    .tl-degree {
      font-family: 'Playfair Display', serif;
      font-size: 1rem; font-weight: 600; color: var(--ice-deep); margin-bottom: 2px;
    }
    .tl-inst { font-size: 13px; font-weight: 500; color: var(--ice-blue); margin-bottom: 3px; }
    .tl-detail { font-size: 12.5px; color: var(--text-muted); line-height: 1.6; }

    /* ---- AWARDS ---- */
    .awards-list { display: flex; flex-direction: column; gap: 0.75rem; }
    .award-item {
      background: var(--ice-frost); border: 1px solid var(--border);
      border-radius: 8px; padding: 1rem 1.25rem;
      display: flex; gap: 1.25rem; align-items: flex-start;
    }
    .award-year {
      font-family: 'Playfair Display', serif;
      font-size: 1rem; font-weight: 600; color: var(--ice-blue);
      min-width: 40px;
    }
    .award-body {}
    .award-name { font-size: 13.5px; font-weight: 500; color: var(--ice-deep); margin-bottom: 2px; }
    .award-detail { font-size: 12px; color: var(--text-muted); }
    .award-pi { display: inline-block; font-size: 10px; font-weight: 600; letter-spacing: 0.8px; background: var(--ice-blue); color: white; padding: 1px 7px; border-radius: 3px; margin-left: 5px; vertical-align: middle; }

    /* ---- PATENTS ---- */
    .patent-item {
      background: white; border: 1px solid var(--border); border-radius: 8px;
      padding: 1.1rem 1.4rem; margin-bottom: 0.75rem;
      display: flex; gap: 1rem; align-items: flex-start;
    }
    .patent-id { font-size: 10px; font-weight: 600; letter-spacing: 0.8px; text-transform: uppercase; color: var(--ice-blue); min-width: 60px; padding-top: 2px; }
    .patent-title { font-size: 13.5px; font-weight: 500; color: var(--ice-deep); margin-bottom: 3px; }
    .patent-authors { font-size: 12px; color: var(--text-muted); }

    /* ---- INDUSTRY ---- */
    .industry-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 1rem; }
    .industry-card {
      background: white; border: 1px solid var(--border); border-radius: 8px;
      padding: 1.1rem 1.25rem; transition: border-color 0.2s;
    }
    .industry-card:hover { border-color: var(--ice-blue); }
    .industry-name { font-weight: 500; font-size: 13px; color: var(--ice-deep); margin-bottom: 3px; }
    .industry-country { font-size: 10px; letter-spacing: 1px; text-transform: uppercase; color: var(--ice-muted); margin-bottom: 4px; }
    .industry-topic { font-size: 12px; color: var(--text-muted); font-style: italic; }

    /* ---- CURRENT MEMBERS ---- */
    .members-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 1.25rem; }
    .member-card {
      background: white; border: 1px solid var(--border); border-radius: 12px;
      padding: 1.5rem 1.25rem; text-align: center; transition: transform 0.2s;
    }
    .member-card:hover { transform: translateY(-2px); }
    .member-avatar {
      width: 60px; height: 60px; border-radius: 50%;
      margin: 0 auto 1rem;
      display: flex; align-items: center; justify-content: center;
      font-family: 'Playfair Display', serif; font-size: 1.1rem; color: white; font-weight: 600;
    }
    .member-name { font-weight: 500; font-size: 14px; color: var(--ice-deep); margin-bottom: 3px; }
    .member-role { font-size: 12px; color: var(--text-muted); }

    /* ---- DIVIDERS ---- */
    .full-width-band { background: var(--ice-frost); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
    .subsec-title {
      font-family: 'Playfair Display', serif;
      font-size: 1.1rem; font-weight: 600; color: var(--ice-deep);
      margin-bottom: 1.25rem; margin-top: 0;
    }
    .subsec-lead { font-size: 13px; color: var(--text-muted); margin-bottom: 1.25rem; line-height: 1.7; max-width: 520px; }
  
  
  
  
  
  
  
  </style>
</head>
