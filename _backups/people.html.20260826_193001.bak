        <div class="member-avatar" style="background: linear-gradient(135deg, rgb(212, 234, 247), rgb(168, 200, 232)); font-size: 1.4rem; position: relative;">+</div>
        <p class="member-name" style="color: var(--text-muted); position: relative;">Funded PhD Position Open</p>
        <p class="member-role" style="position: relative;"><a href="index.html#contact" style="color: var(--ice-blue); position: relative;" class="">Apply now →</a></p>
