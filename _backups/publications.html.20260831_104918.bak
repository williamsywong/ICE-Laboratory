              <p class="pub-journal" style="position: relative;"><em class="" style="position: relative;">Langmuir</em> <span class="" style="position: relative;">· <b>40</b>, 13562–13572</span></p>
              <a class="pub-doi" href="https://doi.org/10.1021/acs.langmuir.4c01085" target="_blank" rel="noopener" style="position: relative;">doi:10.1021/acs.langmuir.4c01085</a>
            </div>
          </div>
        </div>
        <div class="year-group">
          <div class="year-label">2023 <span class="year-count" style="position: relative;">1 publication</span></div>
          
          <div class="pub-card highlighted">
            <div class="pub-thumb" data-thumb-name="2023-design-of-fluoro-free-surfaces-super-rep.jpg" style="position: relative;"><img src="images/Publications/thumb-cropped.png" alt="Design of Fluoro-Free Surfaces Super-Repellent to Low-Surface-Tension Liquids" loading="lazy"></div>
            <div class="pub-type-badge">
              <span class="type-pill type-article" style="position: relative;">Article</span>
            </div>
            <div class="pub-body">
