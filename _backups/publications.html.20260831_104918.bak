<footer>
  <span class="footer-left" style="position: relative; width: 562px; height: 12px;">© 2026 ICE Laboratory · Interfacial Chemical Engineering for Next-Generation Processes</span>
  <span class="footer-visitors" data-cms-skip="1"><img src="https://api.visitorbadge.io/api/visitors?path=ice-group-usyd-website&amp;label=Visitors&amp;countColor=%235bb8e8&amp;style=flat-square&amp;labelColor=%230a1628" alt="Visitor count"></span>
  <span class="footer-usyd" style="position: relative;">The University of Sydney</span>
</footer>

<script src="data/publications.js?v=2"></script>
<script>
  let activeFilter = 'all';
  let activeSort   = 'newest';

  function typeLabel(t) {
    return { article: 'Article', review: 'Review', 'book-chapter': 'Book Chapter' }[t] || t;
  }

  // Deterministic filename for a publication's thumbnail (used both when
  // rendering an existing thumbnail's editor upload target and, if you add
  // one through the Site Editor, as the suggested filename to paste into
  // this entry's "thumbnail" field in data/publications.js).
  function slugify(str) {
    return String(str).toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '').slice(0, 40);
  }

  // Parses "YYYY-MM-DD" as a LOCAL date (not UTC) — new Date("YYYY-MM-DD")
  // parses as UTC midnight, which can silently shift a day in either
  // direction depending on the browser's timezone.
  function parseLocalDate(str) {
    const [y, m, d] = String(str).split('-').map(Number);
    return new Date(y, (m || 1) - 1, d || 1);
  }

  // Full years elapsed since startDateStr, as of 31 December of the most
  // recent year among the publications below — NOT the real-world clock,
  // so this stays fully deterministic (add a further-dated publication to
  // move "now" forward). Returns 0 (hidden by renderStats) before the start
  // date has been reached.
  function yearsSince(startDateStr, pubs) {
    if (typeof startDateStr !== 'string' || !pubs.length) return 0;
    const start = parseLocalDate(startDateStr);
    if (isNaN(start.getTime())) return 0;

    const latestYear = Math.max(...pubs.map(p => p.year));
    const now = new Date(latestYear, 11, 31); // 31 Dec of the latest publication year

    let years = now.getFullYear() - start.getFullYear();
    const hadAnniversary =
      now.getMonth() > start.getMonth() ||
      (now.getMonth() === start.getMonth() && now.getDate() >= start.getDate());
    if (!hadAnniversary) years--;
    return Math.max(0, years);
  }

  function renderStats(pubs) {
    const total    = pubs.length;
    const articles = pubs.filter(p => p.type === 'article').length;
    const reviews  = pubs.filter(p => p.type === 'review').length;
    const piYears    = yearsSince(typeof PI_START_DATE !== 'undefined' ? PI_START_DATE : null, pubs);
    const groupYears = yearsSince(typeof GROUP_START_DATE !== 'undefined' ? GROUP_START_DATE : null, pubs);
    const stats = [
      { num: total,    label: 'Publications' },
      { num: articles, label: 'Articles' },
      { num: reviews,  label: 'Reviews' },
      { num: piYears,    label: "Years of PI's experience" },
      { num: groupYears, label: 'Group Years' },
    ].filter(s => s.num > 0);
    document.getElementById('pubStats').innerHTML = stats.map(s =>
      `<div class="pub-stat"><span class="pub-stat-num">${s.num}</span><span class="pub-stat-label">${s.label}</span></div>`
    ).join('');
  }

  function render() {
    let pubs = [...PUBLICATIONS];

    if (activeFilter === 'highlight') {
      pubs = pubs.filter(p => p.highlight);
    } else if (activeFilter !== 'all') {
      pubs = pubs.filter(p => p.type === activeFilter);
    }

    if (activeSort === 'newest') pubs.sort((a,b) => b.year - a.year);
    else                         pubs.sort((a,b) => a.year - b.year);

    const container = document.getElementById('pubList');

    if (!pubs.length) {
      container.innerHTML = `<div class="no-results"><span>🔬</span>No publications match this filter.</div>`;
      return;
    }

    // Group by year
    const byYear = {};
    pubs.forEach(p => { (byYear[p.year] = byYear[p.year] || []).push(p); });
    const years = Object.keys(byYear).sort((a,b) => activeSort === 'newest' ? b-a : a-b);

    container.innerHTML = years.map(year => {
      const list = byYear[year];
      const cards = list.map(p => {
        const doiLink = p.doi
          ? `<a class="pub-doi" href="https://doi.org/${p.doi}" target="_blank" rel="noopener">doi:${p.doi}</a>`
          : '';
        const volPages = [p.volume && `<b>${p.volume}</b>`, p.pages].filter(Boolean).join(', ');
        const journalStr = p.journal
          ? `<em>${p.journal}</em>${volPages ? ' <span>· ' + volPages + '</span>' : ''}`
          : '';
        const thumbName = `${p.year}-${slugify(p.title)}.jpg`;
        const thumbInner = p.thumbnail
          ? `<img src="images/Publications/${p.thumbnail}" alt="${p.title}" loading="lazy">`
          : `<span class="pub-thumb-ph">📄</span>`;
        return `
          <div class="pub-card ${p.highlight ? 'highlighted' : ''}">
            <div class="pub-thumb" data-thumb-name="${thumbName}">${thumbInner}</div>
            <div class="pub-type-badge">
              <span class="type-pill type-${p.type}">${typeLabel(p.type)}</span>
            </div>
            <div class="pub-body">
              <p class="pub-title">${p.title}${p.highlight ? '<span class="highlight-star">★</span>' : ''}</p>
              <p class="pub-authors">${p.authors}</p>
              ${journalStr ? `<p class="pub-journal">${journalStr}</p>` : ''}
              ${doiLink}
            </div>
          </div>`;
      }).join('');

      return `
        <div class="year-group">
          <div class="year-label">${year} <span class="year-count">${list.length} publication${list.length > 1 ? 's' : ''}</span></div>
          ${cards}
        </div>`;
    }).join('');
  }

  // Filter buttons
  document.querySelectorAll('.filter-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeFilter = btn.dataset.type;
      render();
    });
  });

  // Sort
  document.getElementById('sortSelect').addEventListener('change', e => {
    activeSort = e.target.value;
    render();
  });

  // Initial render
  renderStats(PUBLICATIONS);
  render();
</script>








