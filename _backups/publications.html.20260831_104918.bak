<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ICE Group · University of Sydney</title>
  <link rel="stylesheet" href="css/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
  <style>



    /* ---- PAGE HEADER ---- */
    .page-hero {
      background: var(--ice-deep);
      padding: 5rem 3rem 4rem;
      position: relative;
      overflow: hidden;
    }
    .page-hero::before {
      content: '';
      position: absolute; inset: 0;
      background: radial-gradient(ellipse 50% 80% at 85% 50%, rgba(91,184,232,0.07) 0%, transparent 70%);
    }
    .page-hero-inner {
      max-width: 1100px; margin: 0 auto;
      position: relative; z-index: 1;
    }
    .page-hero h1 {
      font-family: 'Playfair Display', serif;
      font-size: 2.8rem; font-weight: 400;
      color: white; margin-bottom: 0.75rem;
    }
    .page-hero p {
      color: rgba(255,255,255,0.5);
      font-size: 15px; max-width: 500px;
    }

    /* ---- CONTROLS ---- */
    .controls-bar {
      background: white;
      border-bottom: 1px solid var(--border);
      padding: 1.25rem 3rem;
      display: flex; align-items: center;
      gap: 1rem; flex-wrap: wrap;
      position: sticky; top: 64px; z-index: 50;
    }
    .controls-bar label {
      font-size: 12px; letter-spacing: 1px;
      text-transform: uppercase; color: var(--text-muted);
      font-weight: 500; margin-right: 0.25rem;
    }
    .filter-btn {
      background: transparent;
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 0.35rem 1rem;
      font-size: 12.5px; font-weight: 400;
      color: var(--text-muted);
      cursor: pointer;
      transition: all 0.18s;
      font-family: 'DM Sans', sans-serif;
    }
    .filter-btn:hover { border-color: var(--ice-blue); color: var(--ice-blue); }
    .filter-btn.active {
      background: var(--ice-blue); border-color: var(--ice-blue);
      color: white; font-weight: 500;
    }
    .controls-spacer { flex: 1; }
    .sort-select {
      font-size: 12.5px; color: var(--text-muted);
      border: 1px solid var(--border); border-radius: 6px;
      padding: 0.35rem 0.75rem;
      background: white; font-family: 'DM Sans', sans-serif;
      cursor: pointer;
    }

    /* ---- STATS ROW ---- */
    .pub-stats {
      background: var(--ice-mid);
      padding: 1.5rem 3rem;
      display: flex; justify-content: center; gap: 4rem;
      align-items: center;
    }
    .pub-stat { text-align: center; }
    .pub-stat-num {
      font-family: 'Playfair Display', serif;
      font-size: 1.6rem; font-weight: 600;
      color: var(--ice-bright); display: block;
    }
    .pub-stat-label {
      font-size: 11px; letter-spacing: 1.5px;
      text-transform: uppercase; color: rgba(255,255,255,0.4);
    }

    /* ---- PUBLICATION LIST ---- */
    .pub-section { max-width: 1100px; margin: 0 auto; padding: 0 3rem 5rem; }

    .year-group { margin-top: 3.5rem; }
    .year-label {
      font-family: 'Playfair Display', serif;
      font-size: 1.4rem; font-weight: 400;
      color: var(--ice-deep);
      border-bottom: 2px solid var(--ice-pale);
      padding-bottom: 0.5rem;
      margin-bottom: 1.25rem;
      display: flex; align-items: center; gap: 1rem;
    }
    .year-count {
      font-family: 'DM Sans', sans-serif;
      font-size: 12px; font-weight: 400;
      color: var(--text-muted);
      letter-spacing: 0;
    }

    .pub-card {
      background: white;
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 1.5rem 1.75rem;
      margin-bottom: 0.9rem;
      display: flex; gap: 1.25rem;
      align-items: flex-start;
      transition: border-color 0.2s, transform 0.15s;
      position: relative;
    }
    .pub-card:hover { border-color: var(--ice-blue); transform: translateX(2px); }
    .pub-card.highlighted { border-left: 3px solid var(--ice-bright); }

    .pub-thumb {
      width: 64px; height: 64px; border-radius: 8px; flex-shrink: 0;
      background: var(--ice-frost); overflow: hidden; position: relative;
      display: flex; align-items: center; justify-content: center;
    }
    .pub-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .pub-thumb-ph { font-size: 22px; opacity: 0.4; }

    .pub-type-badge {
      min-width: 80px; text-align: center;
      padding: 0.3rem 0;
      margin-top: 2px;
    }
    .type-pill {
      font-size: 10px; font-weight: 500;
      letter-spacing: 0.8px; text-transform: uppercase;
      padding: 3px 9px; border-radius: 20px;
      display: inline-block;
    }
    .type-article   { background: #e6f1fb; color: #185fa5; }
    .type-review    { background: #e1f5ee; color: #0f6e56; }
    .type-book-chapter { background: #fbeaf0; color: #993556; }

    .pub-body { flex: 1; }

    .pub-title {
      font-size: 14.5px; font-weight: 500;
      color: var(--ice-deep); margin-bottom: 0.4rem;
      line-height: 1.5;
    }
    .pub-title .highlight-star {
      color: var(--ice-gold); font-size: 13px; margin-left: 5px;
    }

    .pub-authors {
      font-size: 13px; color: var(--text-muted);
      margin-bottom: 0.3rem;
    }

    .pub-journal {
      font-size: 13px;
    }
    .pub-journal em { color: var(--ice-blue); font-style: italic; }
    .pub-journal span { color: var(--text-muted); }

    .pub-doi {
      display: inline-flex; align-items: center; gap: 5px;
      margin-top: 0.6rem;
      font-size: 12px; color: var(--ice-blue);
      text-decoration: none;
      transition: color 0.15s;
    }
    .pub-doi:hover { color: var(--ice-bright); text-decoration: underline; }
    .pub-doi::before { content: '↗'; font-size: 11px; }

    .no-results {
      text-align: center; padding: 4rem 2rem;
      color: var(--text-muted); font-size: 15px;
    }
    .no-results span { display: block; font-size: 2rem; margin-bottom: 1rem; opacity: 0.4; }
  
  
  
  
  
  
  </style>
<link rel="icon" type="image/png" href="images/Branding/favicon.png">
</head>
