<!-- PAGE HERO -->
<div class="page-hero" style="position: relative; background-image: linear-gradient(rgba(10, 22, 40, 0.55), rgba(10, 22, 40, 0.75)), url('images/Publications/Jumping_Droplets.gif'); background-size: cover, cover; background-position: center center, center center; background-repeat: no-repeat, no-repeat;">
  <div class="page-hero-inner">
    <span class="section-tag" style="color: var(--ice-bright); position: relative;">Research work</span>
    <h1 class="" style="position: relative;">Publications</h1>
    <p class="" style="position: relative;">Peer-reviewed articles, reviews, and book chapters.</p>
  </div>
</div>

<!-- STATS -->
<div class="pub-stats" id="pubStats"><div class="pub-stat"><span class="pub-stat-num" style="position: relative;">40</span><span class="pub-stat-label" style="position: relative;">publications</span></div><div class="pub-stat"><span class="pub-stat-num" style="position: relative;">36</span><span class="pub-stat-label" style="position: relative;">articles</span></div><div class="pub-stat"><span class="pub-stat-num" style="position: relative;">3</span><span class="pub-stat-label" style="position: relative;">Reviews</span></div><div class="pub-stat"><span class="pub-stat-num" style="position: relative;">12</span><span class="pub-stat-label" style="position: relative;">Years of PI's experience</span></div></div>

<!-- FILTER CONTROLS -->
<div class="controls-bar">
  <label>Filter:</label>
  <button class="filter-btn" data-type="all">All</button>
  <button class="filter-btn" data-type="article">Articles</button>
  <button class="filter-btn" data-type="review">Reviews</button>
  <button class="filter-btn" data-type="book-chapter">Book Chapters</button>
  <button class="filter-btn" data-type="highlight">⭐ Highlights</button>
  <div class="controls-spacer"></div>
  <label>Sort:</label>
  <select class="sort-select" id="sortSelect">
    <option value="newest">Newest first</option>
    <option value="oldest">Oldest first</option>
  </select>
</div>

