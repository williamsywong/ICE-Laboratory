<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ICE Group · University of Sydney</title>
  <link rel="stylesheet" href="css/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
  <style>










    /* ---- HERO ---- */
    .hero {
      background: var(--ice-deep);
      padding: 7rem 3rem 5rem;
      position: relative; overflow: hidden;
    }
    .hero::before {
      content: '';
      position: absolute; inset: 0;
      background:
        radial-gradient(ellipse 60% 40% at 80% 50%, rgba(91,184,232,0.08) 0%, transparent 70%),
        radial-gradient(ellipse 40% 60% at 20% 80%, rgba(45,111,168,0.12) 0%, transparent 60%);
    }
    .hero-grid {
      display: grid; grid-template-columns: 1fr 1fr; gap: 4rem;
      max-width: 1100px; margin: 0 auto;
      position: relative; z-index: 1; align-items: center;
    }
    .hero-eyebrow {
      font-size: 11px; font-weight: 500; letter-spacing: 2.5px;
      text-transform: uppercase; color: var(--ice-bright); margin-bottom: 1.5rem;
    }
    .hero-title {
      font-family: 'Playfair Display', serif;
      font-size: 3.4rem; font-weight: 400; line-height: 1.1;
      color: white; margin-bottom: 1rem;
    }
    .hero-title em { font-style: italic; color: var(--ice-bright); }
    .hero-subtitle {
      font-size: 13px; font-weight: 400; letter-spacing: 1.5px;
      text-transform: uppercase; color: var(--ice-muted);
      margin-bottom: 2rem; padding-bottom: 2rem;
      border-bottom: 1px solid rgba(91,184,232,0.15);
    }
    .hero-desc {
      color: rgba(255,255,255,0.65); font-size: 15px; line-height: 1.8;
      margin-bottom: 2.5rem; max-width: 440px; text-align: justify;
    }
    .hero-ctas { display: flex; gap: 1rem; flex-wrap: wrap; }
    .hero-visual { display: flex; align-items: center; justify-content: center; opacity: 0.92; }
    .hero-content > * { animation: fadeUp 0.6s ease both; }
    .hero-content > *:nth-child(1) { animation-delay: 0.05s; }
    .hero-content > *:nth-child(2) { animation-delay: 0.15s; }
    .hero-content > *:nth-child(3) { animation-delay: 0.22s; }
    .hero-content > *:nth-child(4) { animation-delay: 0.30s; }
    .hero-content > *:nth-child(5) { animation-delay: 0.38s; }
    .hero-visual { animation: fadeUp 0.8s 0.2s ease both; }



    /* ---- RESEARCH CARDS ---- */
    .research-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
    .research-card {
      background: white; border: 1px solid var(--border); border-radius: 12px;
      padding: 2rem 1.75rem; position: relative; overflow: hidden;
      min-height: 210px;
      background-size: cover; background-position: center;
      transition: box-shadow 0.2s, transform 0.2s;
    }
    .research-card:hover { transform: translateY(-3px); box-shadow: 0 12px 32px rgba(10,22,40,0.08); }
    .research-card::before {
      content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
      background: linear-gradient(90deg, var(--ice-blue), var(--ice-bright));
    }
    /* When a background photo is set, the top accent bar is redundant and
       title/description switch to light text so they stay readable over
       the dark tint layered under the photo (see researchCardHTML() below). */
    .research-card-photo::before { display: none; }
    .research-card-photo .card-title { color: white; }
    .research-card-photo .card-desc { color: rgba(255,255,255,0.85); }
    .research-card-photo .card-icon { filter: drop-shadow(0 1px 4px rgba(0,0,0,0.5)); }
    .card-icon { font-size: 28px; margin-bottom: 1.25rem; display: block; }
    .card-title {
      font-family: 'Playfair Display', serif; font-size: 1.1rem; font-weight: 600;
      color: var(--ice-deep); margin-bottom: 0.75rem;
    }
    .card-desc { font-size: 13.5px; color: var(--text-muted); line-height: 1.7;}
    .card-abstracts-link {
      display: inline-flex; align-items: center; gap: 5px; margin-top: 1rem;
      font-size: 12px; font-weight: 500; color: var(--ice-blue); text-decoration: none;
    }
    .card-abstracts-link::after { content: '↗'; font-size: 11px; }
    .card-abstracts-link:hover { text-decoration: underline; }
    .research-card-photo .card-abstracts-link { color: white; }

    /* ---- PEOPLE ---- */
    .full-width-band { background: var(--ice-frost); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
    .people-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; }
    .person-card {
      background: white; border: 1px solid var(--border); border-radius: 12px;
      padding: 1.75rem 1.5rem; text-align: center; transition: transform 0.2s;
    }
    .person-card:hover { transform: translateY(-2px); }
    .person-card-open { border: 1px dashed var(--border); background: var(--ice-frost); }
    .person-avatar {
      width: 64px; height: 64px; border-radius: 50%;
      margin: 0 auto 1rem;
      display: flex; align-items: center; justify-content: center;
      font-family: 'Playfair Display', serif; font-size: 1.2rem; color: white; font-weight: 600;
    }
    .person-name { font-weight: 500; font-size: 14px; color: var(--ice-deep); margin-bottom: 0.25rem; }
    .person-role { font-size: 12px; color: var(--text-muted); letter-spacing: 0.3px; }

    /* ---- CONTACT ---- */
    .contact-band {
      background: var(--ice-deep); padding: 5rem 3rem;
      position: relative; overflow: hidden;
    }
    .contact-band::before {
      content: ''; position: absolute; inset: 0;
      background: radial-gradient(ellipse 50% 70% at 90% 50%, rgba(91,184,232,0.07) 0%, transparent 70%);
    }
    .contact-inner {
      max-width: 1100px; margin: 0 auto;
      display: grid; grid-template-columns: 1fr 1fr; gap: 5rem;
      position: relative; z-index: 1; align-items: start;
    }
    .contact-left .section-title { color: white; }
    .contact-left .section-lead  { color: rgba(255,255,255,0.55); }
    .contact-detail { display: flex; gap: 1rem; margin-bottom: 1.25rem; align-items: flex-start; }
    .contact-icon {
      width: 36px; height: 36px; background: rgba(91,184,232,0.1);
      border-radius: 8px; display: flex; align-items: center; justify-content: center;
      flex-shrink: 0; font-size: 16px; color: var(--ice-bright);
    }
    .contact-text-label { font-size: 10px; letter-spacing: 1.5px; text-transform: uppercase; color: var(--ice-muted); display: block; margin-bottom: 2px; }
    .contact-text-val   { font-size: 14px; color: rgba(255,255,255,0.8); }
    .contact-form { display: flex; flex-direction: column; gap: 0.75rem; }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
    .form-input {
      background: rgba(255,255,255,0.06); border: 1px solid rgba(91,184,232,0.15);
      border-radius: 8px; padding: 0.7rem 1rem; color: white;
      font-size: 13px; font-family: 'DM Sans', sans-serif; outline: none; transition: border-color 0.2s;
    }
    .form-input::placeholder { color: rgba(255,255,255,0.3); }
    .form-input:focus { border-color: var(--ice-bright); }
    textarea.form-input { resize: vertical; min-height: 110px; }
    .form-submit {
      background: var(--ice-blue); color: white; border: none;
      padding: 0.8rem 1.75rem; border-radius: 8px; font-size: 13px; font-weight: 500;
      cursor: pointer; font-family: 'DM Sans', sans-serif; align-self: flex-start; transition: background 0.2s;
    }
    .form-submit:hover { background: var(--ice-bright); }
  

    
  
  
  
  
  
  
  
  </style>
<link rel="icon" type="image/png" href="images/Branding/favicon.png">
</head>
<body>

















































<!-- NAV -->
<nav>
  <div class="nav-logo">
    <div class="nav-emblem" style="position: relative; background-image: url('images/Branding/ICE_Logo.png'); background-size: contain; background-position: center center; background-repeat: no-repeat;"></div>
    <a href="index.html" style="text-decoration:none">
      <span class="nav-name" style="position: relative;">ICE Laboratory · University of Sydney</span>
    </a>
  </div>
