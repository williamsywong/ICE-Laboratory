    <span></span><span></span><span></span>
  </button>
  <ul class="nav-links">
    <li data-page="research"><a href="#research">Research</a></li>
    <li data-page="abstracts"><a href="abstracts.html">Abstracts</a></li>
    <li data-page="gallery"><a href="gallery.html">Gallery</a></li>
    <li data-page="publications"><a href="publications.html">Publications</a></li>
    <li data-page="people"><a href="people.html">People</a></li>
    <li data-page="alumni"><a href="alumni.html">Alumni</a></li>
    <li data-page="news"><a href="news.html">News</a></li>
    <li data-page="photos"><a href="photos.html">Photos</a></li>
    <li data-page="join"><a href="#contact">Join Us</a></li>
  </ul>
</nav>

<!-- HERO -->
<div class="hero" style="position: relative; background-image: linear-gradient(rgba(10, 22, 40, 0.55), rgba(10, 22, 40, 0.75)), url('images/Home/e1c041_4ffdee4d63ff4e2298f3555fc616839c_mv2.gif'); background-size: cover, cover; background-position: center center, center center; background-repeat: no-repeat, no-repeat;">
  <div class="hero-grid">
    <div class="hero-content">
      <p class="hero-eyebrow" style="position: relative; height: 21px; width: 631px;" spellcheck="false">University of Sydney · School of Chemical &amp; Biomolecular Engineering</p>
      <h1 class="hero-title" style="position: relative;"><em class="" style="position: relative;">Interfacial</em><br>Chemical Engineering</h1>
      <p class="hero-subtitle" style="position: relative; width: 596px; height: 17px;">Sustainable surface Engineering for next-generation processes</p>
      <p class="hero-desc" style="position: relative; width: 480px; height: 104px;">We investigate the physics and chemistry at the boundaries between phases — gas, liquid, and solid — to engineer transformative understanding and breakthroughs in energy engineering, environmental science, and advanced materials.</p>
      <div class="hero-ctas">
        <a href="#research" class="btn-primary" style="position: relative;">Explore Research</a>
        <a href="#contact" class="btn-secondary" style="position: relative;">Join the Group</a>
      </div>
    </div>
    <div class="hero-visual">
      
    </div>
  </div>
</div>



<!-- RESEARCH -->
<section id="research" style="position: relative;">
  <span class="section-tag" style="position: relative;">Our Research</span>
  <h2 class="section-title" style="position: relative;">Where phases meet, science begins</h2>
  <p class="section-lead" style="position: relative;">The ICE Laboratory focuses on understanding and engineering complex phenomena at interfaces between gas, liquid, and solid phases — from nanoscale molecular interactions to large-scale industrial processes.</p>
  <div class="research-grid" id="researchGrid"><div class="research-card research-card-photo" style="background-image: linear-gradient(rgba(10, 22, 40, 0.45), rgba(10, 22, 40, 0.75)), url(&quot;images/Home/2025_ACSNano.png-cropped.png-cropped.png&quot;); position: relative;">
      <span class="card-icon" style="position: relative;">🧪</span>
      <h3 class="card-title" style="position: relative;">Surface Chemistry</h3>
      <p class="card-desc" style="position: relative;">Engineering interfacial chemistry, wettability, and surface charge through liquid- and vapor-phase functionalization.</p>
    </div><div class="research-card research-card-photo" style="background-image: linear-gradient(rgba(10, 22, 40, 0.45), rgba(10, 22, 40, 0.75)), url(&quot;images/Home/2016_Re-entrant_Nanoparticles.jpg&quot;); position: relative;">
      <span class="card-icon" style="position: relative;">🧩</span>
      <h3 class="card-title" style="position: relative;">Surface Engineering</h3>
      <p class="card-desc" style="position: relative;">Designing hierarchical surfaces across nano-, micro-, and macro-scales using self-assembly, particle technologies, lithography, and 3D printing.</p>
    </div><div class="research-card research-card-photo" style="background-image: linear-gradient(rgba(10, 22, 40, 0.45), rgba(10, 22, 40, 0.75)), url(&quot;images/Home/2020_Langmuir.png-cropped.png&quot;); position: relative;">
      <span class="card-icon" style="position: relative;">🔬</span>
      <h3 class="card-title" style="position: relative;">Surface Characterization</h3>
      <p class="card-desc" style="position: relative;">Probing surface structure, chemistry, and interfacial dynamics using advanced microscopy, spectroscopy, and quantitative imaging.</p>
    </div><div class="research-card research-card-photo" style="background-image: linear-gradient(rgba(10, 22, 40, 0.45), rgba(10, 22, 40, 0.75)), url(&quot;images/Home/Debubbling-crop.gif&quot;); position: relative;">
      <span class="card-icon" style="position: relative;">🫧</span>
      <h3 class="card-title" style="position: relative;">Multiphase Flow &amp; Transport</h3>
      <p class="card-desc" style="position: relative;">Understanding gas–liquid and gas–solid interactions, bubble dynamics, and transport phenomena in multiphase systems and reactors.</p>
    </div><div class="research-card research-card-photo" style="background-image: linear-gradient(rgba(10, 22, 40, 0.45), rgba(10, 22, 40, 0.75)), url(&quot;images/Home/2022_Effervescence.jpg-cropped.png&quot;); position: relative;">
      <span class="card-icon" style="position: relative;">⚡</span>
      <h3 class="card-title" style="position: relative;">Electrochemical Interfaces</h3>
      <p class="card-desc" style="position: relative;">Engineering electrode–electrolyte interfaces and solid-liquid-gas interactions to improve the efficiency and stability of electrochemical systems.</p>
    </div><div class="research-card research-card-photo" style="background-image: linear-gradient(rgba(10, 22, 40, 0.45), rgba(10, 22, 40, 0.75)), url(&quot;images/Home/2023_Fluoro-Free.jpg-cropped.png&quot;); position: relative;">
      <span class="card-icon" style="position: relative;">🌍</span>
      <h3 class="card-title" style="position: relative;">Sustainable Processing</h3>
      <p class="card-desc" style="position: relative;">Developing energy-passive and sustainable interfacial technologies for water treatment, pollutant removal, and resource-efficient processing.</p>
    </div></div>
<span class="cms-hoverable" style="position: absolute; left: 770px; top: 86px; display: inline-block; z-index: 5;"></span><span class="cms-hoverable" style="position: absolute; left: 735px; top: 73px; display: inline-block; z-index: 5;"><img src="images/Home/20260817_Group_Logo-removebg_1_1.png" alt="20260817_Group_Logo-removebg_1.png" class="" style="width: 316px; max-width: 90vw; height: auto; border-radius: 6px; display: block; cursor: pointer;"></span></section>

<!-- PEOPLE -->
<div class="full-width-band">
<section id="people" style="position: relative;">
  <span class="section-tag" style="position: relative;">The Team</span>
  <h2 class="section-title" style="position: relative;">People</h2>
  <p class="section-lead" style="position: relative; width: 530px; height: 55px;">A collaborative team united by curiosity about interfacial engineering.&nbsp;<br><a href="https://williamsywong.github.io/ICE-Laboratory/news.html" target="_blank" rel="noopener" class="" style="position: relative;">View fully-funded open positions</a>.<br></p>
  <div class="people-grid" id="teamGridHome"><div class="person-card">
      <div class="person-avatar" style="background: url(&quot;images/Headshots/People-WW.png&quot;) center center / cover; position: relative;"></div>
      <p class="person-name" style="position: relative;">Dr. William S. Y. Wong</p>
      <p class="person-role" style="position: relative;">Lecturer &amp; Group Leader</p>
    </div><div class="person-card person-card-open">
        <div class="person-avatar" style="background: linear-gradient(135deg, rgb(212, 234, 247), rgb(168, 200, 232)); font-size: 1.4rem; color: rgb(45, 111, 168); position: relative;">+</div>
        <p class="person-name" style="color: var(--text-muted); position: relative;">Funded PhD Position Open</p>
        <p class="person-role" style="position: relative;"><a href="index.html#contact" style="color: var(--ice-blue); position: relative;" class="">Apply now →</a></p>
      </div><div class="person-card person-card-open">
        <div class="person-avatar" style="background: linear-gradient(135deg, rgb(212, 234, 247), rgb(168, 200, 232)); font-size: 1.4rem; color: rgb(45, 111, 168); position: relative;">+</div>
        <p class="person-name" style="color: var(--text-muted); position: relative;">Funded PhD Position Open</p>
        <p class="person-role" style="position: relative;"><a href="index.html#contact" style="color: var(--ice-blue); position: relative;" class="">Apply now →</a></p>
      </div><div class="person-card person-card-open">
        <div class="person-avatar" style="background: linear-gradient(135deg, rgb(212, 234, 247), rgb(168, 200, 232)); font-size: 1.4rem; color: rgb(45, 111, 168); position: relative;">+</div>
        <p class="person-name" style="color: var(--text-muted); position: relative;">B.Eng. Thesis Project / Master's by Research</p>
        <p class="person-role" style="position: relative;"><a href="index.html#contact" style="color: var(--ice-blue); position: relative;" class="">Apply now →</a></p>
      </div><div class="person-card person-card-open">
        <div class="person-avatar" style="background: linear-gradient(135deg, rgb(212, 234, 247), rgb(168, 200, 232)); font-size: 1.4rem; color: rgb(45, 111, 168); position: relative;">+</div>
        <p class="person-name" style="color: var(--text-muted); position: relative;">Self-funded Positions (Ph.D. / PD fellowships)</p>
        <p class="person-role" style="position: relative;"><a href="index.html#contact" style="color: var(--ice-blue); position: relative;" class="">Apply now →</a></p>
      </div></div>
  <p style="margin-top: 1.5rem; font-size: 13px; color: var(--text-muted); position: relative; width: 1007px; height: 66px;" class="">Recruitment takes place on a rolling basis and is open to self-funded positions.&nbsp;<br><br>Details regarding eligibility, application procedures and English-language requirements can be found in this <a href="https://www.sydney.edu.au/courses/courses/pr/doctor-of-philosophy-engineering.html" target="_blank" rel="noopener" class="" style="position: relative;">link</a>.<br></p>

<span class="cms-hoverable" style="position: absolute; left: 265px; top: 919px; display: inline-block; z-index: 5;"><img src="images/Home/USYD_1.png" alt="USYD.png" class="" style="width: 251px; max-width: 90vw; height: auto; border-radius: 6px; display: block; cursor: pointer;"></span></section></div>

<!-- CONTACT -->
<div class="contact-band" id="contact" style="position: relative;">
  <div class="contact-inner">
    <div class="contact-left">
