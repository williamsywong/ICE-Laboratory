<script src="data/research.js"></script>
<script>
  // Research area cards now live in data/research.js (RESEARCH array) — edit
  // that file to add/remove/reorder cards; the Site Editor's text edits to
  // an existing card's icon/title/description/photo sync back there on Save.
  //
  // Each card links to abstracts.html, where any abstract tagged with this
  // card's exact title (its data/abstracts.js "researchArea" field) gets
  // scrolled to and briefly highlighted. Which abstracts link to which card
  // is set per-abstract from the Site Editor's Abstracts tab, not here.
  function researchCardHTML(r) {
    const hasImage = !!r.image;
    const style = hasImage
      ? ` style="background-image:linear-gradient(180deg, rgba(10,22,40,0.45), rgba(10,22,40,0.75)), url('images/Home/${r.image}');"`
      : '';
    return `<div class="research-card${hasImage ? ' research-card-photo' : ''}"${style}>
      <span class="card-icon">${r.icon}</span>
      <h3 class="card-title">${r.title}</h3>
      <p class="card-desc">${r.desc}</p>
      <a class="card-abstracts-link" href="abstracts.html?area=${encodeURIComponent(r.title)}">View related abstracts</a>
    </div>`;
  }
  document.getElementById('researchGrid').innerHTML = RESEARCH.map(researchCardHTML).join('');
</script>

<script src="data/team.js"></script>
<script>
  // Team roster now lives in data/team.js (TEAM array) — shared with people.html —
  // edit that one file to add/remove/reorder team members or open positions.
  function personCardHTML(m) {
    if (m.open) {
      return `<div class="person-card person-card-open">
        <div class="person-avatar" style="background:linear-gradient(135deg,#d4eaf7,#a8c8e8); font-size:1.4rem; color:#2d6fa8;">+</div>
        <p class="person-name" style="color:var(--text-muted);">${m.role}</p>
        <p class="person-role"><a href="${m.link || 'index.html#contact'}" style="color:var(--ice-blue);">${m.linkText || 'Apply now →'}</a></p>
      </div>`;
    }
    const avatarStyle = m.photo
      ? `background:url('images/Headshots/${m.photo}') center center / cover;`
      : `background:${m.color || 'linear-gradient(135deg,#5bb8e8,#1a3a5c)'};`;
    return `<div class="person-card">
      <div class="person-avatar" style="${avatarStyle}">${m.photo ? '' : (m.initials || '')}</div>
      <p class="person-name">${m.name}</p>
      <p class="person-role">${m.role}</p>
    </div>`;
  }
  document.getElementById('teamGridHome').innerHTML = TEAM.map(personCardHTML).join('');
</script>















<span class="cms-hoverable" style="position: relative; display: inline-block; left: -7px; top: 85px;"></span>





























</body>
</html>