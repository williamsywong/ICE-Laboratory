anslate3d(696px, 310px, 0px); z-index: 310;"></div><div class="leaflet-marker-icon network-pin leaflet-zoom-animated leaflet-interactive" tabindex="0" role="button" style="margin-left: -5.5px; margin-top: -5.5px; width: 11px; height: 11px; transform: translate3d(654px, 212px, 0px); z-index: 212;"></div><div class="leaflet-marker-icon network-pin leaflet-zoom-animated leaflet-interactive" tabindex="0" role="button" style="margin-left: -5.5px; margin-top: -5.5px; width: 11px; height: 11px; transform: translate3d(687px, 317px, 0px); z-index: 317;"></div><div class="leaflet-marker-icon network-pin leaflet-zoom-animated leaflet-interactive" tabindex="0" role="button" style="margin-left: -5.5px; margin-top: -5.5px; width: 11px; height: 11px; transform: translate3d(629px, 257px, 0px); z-index: 257;"></div><div class="leaflet-marker-icon network-pin leaflet-zoom-animated leaflet-interactive" tabindex="0" role="button" style="margin-left: -5.5px; margin-top: -5.5px; width: 11px; height: 11px; transform: translate3d(661px, 186px, 0px); z-index: 186;"></div><div class="leaflet-marker-icon network-pin leaflet-zoom-animated leaflet-interactive" tabindex="0" role="button" style="margin-left: -5.5px; margin-top: -5.5px; width: 11px; height: 11px; transform: translate3d(693px, 313px, 0px); z-index: 313;"></div><div class="leaflet-marker-icon network-pin leaflet-zoom-animated leaflet-interactive" tabindex="0" role="button" style="margin-left: -5.5px; margin-top: -5.5px; width: 11px; height: 11px; transform: translate3d(379px, 309px, 0px); z-index: 309;"></div><div class="leaflet-marker-icon network-pin leaflet-zoom-animated leaflet-interactive" tabindex="0" role="button" style="margin-left: -5.5px; margin-top: -5.5px; width: 11px; height: 11px; transform: translate3d(511px, 198px, 0px); z-index: 198;"></div><div class="leaflet-marker-icon network-pin leaflet-zoom-animated leaflet-interactive" tabindex="0" role="button" style="margin-left: -5.5px; margin-top: -5.5px; width: 11px; height: 11px; transform: translate3d(493px, 176px, 0px); z-index: 176;"></div><div class="leaflet-marker-icon network-pin leaflet-zoom-animated leaflet-interactive" tabindex="0" role="button" style="margin-left: -5.5px; margin-top: -5.5px; width: 11px; height: 11px; transform: translate3d(650px, 211px, 0px); z-index: 211;"></div><div class="leaflet-marker-icon network-pin leaflet-zoom-animated leaflet-interactive" tabindex="0" role="button" style="margin-left: -5.5px; margin-top: -5.5px; width: 11px; height: 11px; transform: translate3d(376px, 195px, 0px); z-index: 195;"></div><div class="leaflet-marker-icon network-pin leaflet-zoom-animated leaflet-interactive" tabindex="0" role="button" style="margin-left: -5.5px; margin-top: -5.5px; width: 11px; height: 11px; transform: translate3d(508px, 176px, 0px); z-index: 176;"></div><div class="leaflet-marker-icon network-pin leaflet-zoom-animated leaflet-interactive" tabindex="0" role="button" style="margin-left: -5.5px; margin-top: -5.5px; width: 11px; height: 11px; transform: translate3d(477px, 191px, 0px); z-index: 191;"></div><div class="leaflet-marker-icon network-pin leaflet-zoom-animated leaflet-interactive" tabindex="0" role="button" style="margin-left: -5.5px; margin-top: -5.5px; width: 11px; height: 11px; transform: translate3d(628px, 257px, 0px); z-index: 257;"></div><div class="leaflet-marker-icon network-pin leaflet-zoom-animated leaflet-interactive" tabindex="0" role="button" style="margin-left: -5.5px; margin-top: -5.5px; width: 11px; height: 11px; transform: translate3d(481px, 172px, 0px); z-index: 172;"></div><div class="leaflet-marker-icon network-pin leaflet-zoom-animated leaflet-interactive" tabindex="0" role="button" style="margin-left: -5.5px; margin-top: -5.5px; width: 11px; height: 11px; transform: translate3d(307px, 201px, 0px); z-index: 201;"></div><div class="leaflet-marker-icon network-pin leaflet-zoom-animated leaflet-interactive" tabindex="0" role="button" style="margin-left: -5.5px; margin-top: -5.5px; width: 11px; height: 11px; transform: translate3d(316px, 190px, 0px); z-index: 190;"></div><div class="leaflet-marker-icon network-pin leaflet-zoom-animated leaflet-interactive" tabindex="0" role="button" style="margin-left: -5.5px; margin-top: -5.5px; width: 11px; height: 11px; transform: translate3d(306px, 189px, 0px); z-index: 189;"></div><div class="leaflet-marker-icon network-pin leaflet-zoom-animated leaflet-interactive" tabindex="0" role="button" style="margin-left: -5.5px; margin-top: -5.5px; width: 11px; height: 11px; transform: translate3d(494px, 179px, 0px); z-index: 179;"></div><div class="leaflet-marker-icon network-pin leaflet-zoom-animated leaflet-interactive" tabindex="0" role="button" style="margin-left: -5.5px; margin-top: -5.5px; width: 11px; height: 11px; transform: translate3d(517px, 151px, 0px); z-index: 151;"></div><div class="leaflet-marker-icon network-pin leaflet-zoom-animated leaflet-interactive" tabindex="0" role="button" style="margin-left: -5.5px; margin-top: -5.5px; width: 11px; height: 11px; transform: translate3d(493px, 182px, 0px); z-index: 182;"></div><div class="leaflet-marker-icon network-pin leaflet-zoom-animated leaflet-interactive" tabindex="0" role="button" style="margin-left: -5.5px; margin-top: -5.5px; width: 11px; height: 11px; transform: translate3d(361px, 198px, 0px); z-index: 198;"></div><div class="leaflet-marker-icon network-pin leaflet-zoom-animated leaflet-interactive" tabindex="0" role="button" style="margin-left: -5.5px; margin-top: -5.5px; width: 11px; height: 11px; transform: translate3d(476px, 163px, 0px); z-index: 163;"></div><div class="leaflet-marker-icon network-pin leaflet-zoom-animated leaflet-interactive" tabindex="0" role="button" style="margin-left: -5.5px; margin-top: -5.5px; width: 11px; height: 11px; transform: translate3d(654px, 199px, 0px); z-index: 199;"></div><div class="leaflet-marker-icon network-pin leaflet-zoom-animated leaflet-interactive" tabindex="0" role="button" style="margin-left: -5.5px; margin-top: -5.5px; width: 11px; height: 11px; transform: translate3d(649px, 203px, 0px); z-index: 203;"></div><div class="leaflet-marker-icon network-pin leaflet-zoom-animated leaflet-interactive" tabindex="0" role="button" style="margin-left: -5.5px; margin-top: -5.5px; width: 11px; height: 11px; transform: translate3d(680px, 205px, 0px); z-index: 205;"></div><div class="leaflet-marker-icon network-pin leaflet-zoom-animated leaflet-interactive" tabindex="0" role="button" style="margin-left: -5.5px; margin-top: -5.5px; width: 11px; height: 11px; transform: translate3d(523px, 144px, 0px); z-index: 144;"></div><div class="leaflet-marker-icon network-pin leaflet-zoom-animated leaflet-interactive" tabindex="0" role="button" style="margin-left: -5.5px; margin-top: -5.5px; width: 11px; height: 11px; transform: translate3d(537px, 226px, 0px); z-index: 226;"></div><div class="leaflet-marker-icon network-pin leaflet-zoom-animated leaflet-interactive" tabindex="0" role="button" style="margin-left: -5.5px; margin-top: -5.5px; width: 11px; height: 11px; transform: translate3d(663px, 220px, 0px); z-index: 220;"></div><div class="leaflet-marker-icon network-pin leaflet-zoom-animated leaflet-interactive" tabindex="0" role="button" style="margin-left: -5.5px; margin-top: -5.5px; width: 11px; height: 11px; transform: translate3d(491px, 175px, 0px); z-index: 175;"></div><div class="leaflet-marker-icon network-pin leaflet-zoom-animated leaflet-interactive" tabindex="0" role="button" style="margin-left: -5.5px; margin-top: -5.5px; width: 11px; height: 11px; transform: translate3d(515px, 147px, 0px); z-index: 147;"></div><div class="leaflet-marker-icon network-pin leaflet-zoom-animated leaflet-interactive" tabindex="0" role="button" style="margin-left: -5.5px; margin-top: -5.5px; width: 11px; height: 11px; transform: translate3d(374px, 197px, 0px); z-index: 197;"></div></div><div class="leaflet-pane leaflet-tooltip-pane"></div><div class="leaflet-pane leaflet-popup-pane"></div><div class="leaflet-proxy leaflet-zoom-animated" style="transform: translate3d(275.993px, 185.991px, 0px) scale(1);"></div></div><div class="leaflet-control-container"><div class="leaflet-top leaflet-left"><div class="leaflet-control-zoom leaflet-bar leaflet-control"><a class="leaflet-control-zoom-in" href="#" title="Zoom in" role="button" aria-label="Zoom in" aria-disabled="false"><span aria-hidden="true">+</span></a><a class="leaflet-control-zoom-out" href="#" title="Zoom out" role="button" aria-label="Zoom out" aria-disabled="false"><span aria-hidden="true">−</span></a></div></div><div class="leaflet-top leaflet-right"></div><div class="leaflet-bottom leaflet-left"></div><div class="leaflet-bottom leaflet-right"><div class="leaflet-control-attribution leaflet-control"><a href="https://leafletjs.com" title="A JavaScript library for interactive maps"><span class="cms-hoverable" data-cms-resize-tracked="1" style="position: relative; display: inline-block; width: 12px; height: 8px;"><svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="12" height="8" viewBox="0 0 12 8" class="leaflet-attribution-flag" style="width: 100%; height: 100%;"><path fill="#4C7BE1" d="M0 0h12v4H0z"></path><path fill="#FFD500" d="M0 4h12v3H0z"></path><path fill="#E0BC00" d="M0 7h12v1H0z"></path></svg></span> Leaflet</a> <span aria-hidden="true">|</span> © <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a> contributors © <a href="https://carto.com/attributions" target="_blank" rel="noopener">CARTO</a></div></div></div></div>
  <div class="map-legend" data-cms-skip="1">
    <span><span class="dot blue"></span>Featured collaborators</span>
    <span><span class="dot gold"></span>Extended network</span>
  </div>
  <div class="collab-grid" id="collabGrid">
      <div class="collab-card">
        <p class="collab-name" style="position: relative;">Prof. Doris Vollmer</p>
        <p class="collab-inst" style="position: relative;">Max Planck Institute for Polymer Research, Mainz</p>
        <p class="collab-topic" style="position: relative;">Superamphiphobic, lubricated, and self-cleaning surfaces</p>
      </div>
      <div class="collab-card">
        <p class="collab-name" style="position: relative;">Prof. Hans-Jürgen Butt</p>
        <p class="collab-inst" style="position: relative;">Max Planck Institute for Polymer Research, Mainz</p>
        <p class="collab-topic" style="position: relative;">Wetting, drops, adaptation, electrification</p>
      </div>
      <div class="collab-card">
        <p class="collab-name" style="position: relative;">Prof. Robin Ras</p>
        <p class="collab-inst" style="position: relative;">Aalto University, Helsinki</p>
        <p class="collab-topic" style="position: relative;">Superhydrophobicity and wetting characterization</p>
      </div>
      <div class="collab-card">
        <p class="collab-name" style="position: relative;">Prof. Tapio Ala-Nissilä</p>
        <p class="collab-inst" style="position: relative;">Aalto University, Helsinki</p>
        <p class="collab-topic" style="position: relative;">Molecular dynamics and ab initio simulations</p>
      </div>
      <div class="collab-card">
        <p class="collab-name" style="position: relative;">Prof. Vincent Craig</p>
        <p class="collab-inst" style="position: relative;">Australian National University, Canberra</p>
        <p class="collab-topic" style="position: relative;">Surface forces and wetting</p>
      </div>
      <div class="collab-card">
        <p class="collab-name" style="position: relative;">Prof. Antonio Tricoli</p>
        <p class="collab-inst" style="position: relative;">University of Sydney, Sydney</p>
        <p class="collab-topic" style="position: relative;">Nanostructure design</p>
      </div></div>
</div>
</div>

<!-- CTA -->
<section style="text-align:center; padding: 4rem 3rem;">
  <span class="section-tag" style="display: block; text-align: center; margin-bottom: 0.75rem; position: relative;">Join Us</span>
  <h2 class="section-title" style="text-align: center; margin-bottom: 0.75rem; position: relative;">Become Part of the ICE Laboratory</h2>
  <p style="color: var(--text-muted); max-width: 480px; margin: 0px auto 2rem; font-size: 15px; line-height: 1.75; position: relative;" class="">
    We welcome motivated PhD applicants and postdoctoral researchers with backgrounds in chemical engineering, mechanical engineering, materials science, chemistry, and applied physics.</p>
  <a href="index.html#contact" class="btn-primary" style="position: relative;">Get in Touch</a>
</section>

<!-- FOOTER -->
<footer>
  <span class="footer-left" style="position: relative; width: 562px; height: 12px;">© 2026 ICE Laboratory · Interfacial Chemical Engineering for Next-Generation Processes</span>
  <span class="footer-visitors" data-cms-skip="1"><img src="https://api.visitorbadge.io/api/visitors?path=ice-group-usyd-website&amp;label=Visitors&amp;countColor=%235bb8e8&amp;style=flat-square&amp;labelColor=%230a1628" alt="Visitor count"></span>
  <span class="footer-usyd" style="position: relative;">The University of Sydney</span>
</footer>

<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
<script src="data/alumni.js"></script>
<script>
  // Both sections on this page render entirely from data/alumni.js:
  //   - ALUMNI + ALUMNI_LEVELS drive the "Alumni" section, auto-ranked by seniority
  //   - COLLABORATORS drives the "Collaborators" section
  // Edit that one file to add, remove, or update anyone shown here.

  // A small fixed palette so every card gets a colour even if the data
  // entry doesn't specify one — cycles by position in the sorted list.
  const AVATAR_PALETTE = [
    'linear-gradient(135deg,#5bb8e8,#1a3a5c)',
    'linear-gradient(135deg,#7ec8e3,#2d6fa8)',
    'linear-gradient(135deg,#2d6fa8,#5bb8e8)',
    'linear-gradient(135deg,#1a3a5c,#7ec8e3)',
    'linear-gradient(135deg,#5bb8e8,#2d6fa8)',
    'linear-gradient(135deg,#7ec8e3,#1a3a5c)',
  ];

  function initialsOf(name) {
    const words = name.replace(/[()]/g, '').trim().split(/\s+/);
    const letters = words.filter(w => /^[A-Z]/.test(w)).map(w => w[0]);
    return (letters.slice(0, 2).join('') || name.slice(0, 2)).toUpperCase();
  }

  function alumniCardHTML(person, i) {
    const levelCfg = ALUMNI_LEVELS[person.level] || { label: person.level || '' };
    const color = person.color || AVATAR_PALETTE[i % AVATAR_PALETTE.length];
    const badge = levelCfg.label + (person.institution ? ' · ' + person.institution : '');
    return `
      <div class="alumni-card">
        <div class="alumni-avatar" style="background:${color}">${initialsOf(person.name)}</div>
        <div class="alumni-body">
          <p class="alumni-name">${person.name}</p>
          <p class="alumni-degree">${badge}</p>
          <p class="alumni-thesis">${person.focus || ''}</p>
          <p class="alumni-now">${person.position || ''}</p>
        </div>
      </div>`;
  }

  function collabCardHTML(c) {
    return `
      <div class="collab-card">
        <p class="collab-name">${c.name}</p>
        <p class="collab-inst">${c.institution}</p>
        <p class="collab-topic">${c.topic}</p>
      </div>`;
  }

  // Rank by seniority (Postdoc → PhD → Masters → Bachelor) regardless of the
  // order entries appear in data/alumni.js. Array.prototype.sort is stable,
  // so entries at the same level keep their original (roughly date) order.
  const rankOf = p => (ALUMNI_LEVELS[p.level] ? ALUMNI_LEVELS[p.level].rank : 99);
  const sortedAlumni = [...ALUMNI].sort((a, b) => rankOf(a) - rankOf(b));

  document.getElementById('alumniGrid').innerHTML = sortedAlumni.map(alumniCardHTML).join('');
  document.getElementById('collabGrid').innerHTML = COLLABORATORS.map(collabCardHTML).join('');

  // Stats strip — computed live from the data so it never goes stale
  const countByLevel = lvl => ALUMNI.filter(p => p.level === lvl).length;
  const institutionCount = new Set(ALUMNI.map(p => p.institution).filter(Boolean)).size;
  const stats = [
    { num: countByLevel('Postdoc'), label: 'Postdocs supervised' },
    { num: countByLevel('PhD'), label: 'PhD students' },
    { num: countByLevel('Masters') + countByLevel('Bachelor'), label: 'UG / Masters students' },
    { num: institutionCount, label: 'Institutions' },
  ];
  document.getElementById('statsStrip').innerHTML = stats.map(s =>
    `<div class="stat-item"><span class="stat-num">${s.num}</span><span class="stat-label">${s.label}</span></div>`
  ).join('');

  // ── Collaborators map — one pin per unique location, auto-plotted from the
  // lat/lng on each entry. Two tiers:
  //   - COLLABORATORS (featured, with cards below) → bold blue pins
  //   - COLLABORATOR_NETWORK (institution + coordinates only, no cards) → smaller gold pins
  // Entries sharing coordinates (e.g. several people at the same institution)
  // share a single pin, with all of them listed together in its popup.
  const located = COLLABORATORS.filter(c => typeof c.lat === 'number' && typeof c.lng === 'number');
  const networkLocated = (typeof COLLABORATOR_NETWORK !== 'undefined' ? COLLABORATOR_NETWORK : [])
    .filter(c => typeof c.lat === 'number' && typeof c.lng === 'number');

  if ((located.length || networkLocated.length) && window.L) {
    const mapEl = document.getElementById('collabMap');
    // Defensive: if this container already has leftover map DOM baked in from
    // a previous save (the editor's Save captures whatever is on screen at
    // that moment), clear it first — Leaflet expects a fresh, empty element.
    if (mapEl) mapEl.innerHTML = '';

    const byLocation = new Map();
    located.forEach(c => {
      const key = c.lat.toFixed(2) + ',' + c.lng.toFixed(2);
      if (!byLocation.has(key)) byLocation.set(key, { lat: c.lat, lng: c.lng, people: [] });
      byLocation.get(key).people.push(c);
    });

    const byNetworkLocation = new Map();
    networkLocated.forEach(c => {
      const key = c.lat.toFixed(2) + ',' + c.lng.toFixed(2);
      if (!byNetworkLocation.has(key)) byNetworkLocation.set(key, { lat: c.lat, lng: c.lng, institution: c.institution, count: 0 });
      byNetworkLocation.get(key).count += 1;
    });

    const map = L.map('collabMap', { scrollWheelZoom: false, worldCopyJump: true });
    L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_nolabels/{z}/{x}/{y}{r}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions" target="_blank" rel="noopener">CARTO</a>',
      subdomains: 'abcd',
      maxZoom: 18
    }).addTo(map);

    const pinIcon = L.divIcon({ className: 'collab-pin', iconSize: [16, 16] });
    const networkPinIcon = L.divIcon({ className: 'network-pin', iconSize: [11, 11] });
    const markers = [];

    byLocation.forEach(loc => {
      const popupHTML = loc.people.map(p => `
        <p class="collab-popup-name">${p.name}</p>
        <p class="collab-popup-inst">${p.institution}</p>
        <p class="collab-popup-topic">${p.topic}</p>
      `).join('<hr style="border:none;border-top:1px solid var(--border);margin:6px 0;">');
      const marker = L.marker([loc.lat, loc.lng], { icon: pinIcon }).bindPopup(popupHTML);
      marker.addTo(map);
      markers.push(marker);
    });

    byNetworkLocation.forEach(loc => {
      const popupHTML = `
        <p class="collab-popup-name">${loc.institution}</p>
        <p class="collab-popup-count">${loc.count} collaborator${loc.count > 1 ? 's' : ''}</p>
      `;
      // If a featured (blue) pin already sits at this exact spot — e.g. an
      // institution with both a featured collaborator and wider-network
      // collaborators — nudge the gold pin slightly so the two don't render
      // stacked directly on top of each other. Doesn't touch the stored data.
      const key = loc.lat.toFixed(2) + ',' + loc.lng.toFixed(2);
      const pos = byLocation.has(key) ? [loc.lat + 0.18, loc.lng + 0.18] : [loc.lat, loc.lng];
      const marker = L.marker(pos, { icon: networkPinIcon }).bindPopup(popupHTML);
      marker.addTo(map);
      markers.push(marker);
    });

    if (markers.length === 1) {
      map.setView(markers[0].getLatLng(), 5);
    } else {
      map.fitBounds(L.featureGroup(markers).getBounds().pad(0.25));
    }
  } else {
    // No coordinates yet (or Leaflet failed to load, e.g. offline) — hide the
    // empty map area rather than show a blank box.
    const mapEl = document.getElementById('collabMap');
    if (mapEl) mapEl.style.display = 'none';
    const legendEl = document.querySelector('.map-legend');
    if (legendEl) legendEl.style.display = 'none';
  }
</script>








</body>
</html>