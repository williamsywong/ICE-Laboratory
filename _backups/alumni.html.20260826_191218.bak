<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ICE Group · University of Sydney</title>
  <link rel="stylesheet" href="css/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="css/style.css">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=DM+Sans:wght@300;400;500&display=swap">
  <link rel="stylesheet" href="css/style.css">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=DM+Sans:wght@300;400;500&display=swap">
  <link rel="stylesheet" href="css/style.css">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=DM+Sans:wght@300;400;500&display=swap">
  <link rel="stylesheet" href="css/style.css">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=DM+Sans:wght@300;400;500&display=swap">
  <link rel="stylesheet" href="css/style.css">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=DM+Sans:wght@300;400;500&display=swap">
  <link rel="stylesheet" href="css/style.css">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=DM+Sans:wght@300;400;500&display=swap">
  <link rel="stylesheet" href="css/style.css">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=DM+Sans:wght@300;400;500&display=swap">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css">
  <style>








    /* ---- PAGE HERO ---- */
    .page-hero {
      background: var(--ice-deep);
      padding: 5rem 3rem 4rem;
      position: relative; overflow: hidden;
    }
    .page-hero::before {
      content: ''; position: absolute; inset: 0;
      background: radial-gradient(ellipse 50% 80% at 15% 60%, rgba(91,184,232,0.07) 0%, transparent 70%);
    }
    .page-hero-inner { max-width: 1100px; margin: 0 auto; position: relative; z-index: 1; }
    .page-hero h1 {
      font-family: 'Playfair Display', serif;
      font-size: 2.8rem; font-weight: 400; color: white; margin-bottom: 0.75rem;
    }
    .page-hero p { color: rgba(255,255,255,0.5); font-size: 15px; max-width: 540px; }

    /* ---- SECTION ---- */
    .alumni-section { max-width: 1100px; margin: 0 auto; padding: 4rem 3rem 5rem; }

    /* ── ALUMNI GRID (single flowing grid, ranked by seniority) ── */
    .alumni-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 1rem;
    }

    .alumni-card {
      background: white;
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 1.4rem 1.5rem;
      display: flex; gap: 1rem; align-items: flex-start;
      transition: border-color 0.2s, transform 0.15s;
      position: relative;
    }
    .alumni-card:hover { border-color: var(--ice-blue); transform: translateY(-2px); }

    .alumni-avatar {
      width: 48px; height: 48px; border-radius: 50%; flex-shrink: 0;
      display: flex; align-items: center; justify-content: center;
      font-family: 'Playfair Display', serif; font-size: 1rem;
      font-weight: 600; color: white;
    }

    .alumni-body { flex: 1; min-width: 0; }
    .alumni-name { font-weight: 500; font-size: 14px; color: var(--ice-deep); margin-bottom: 1px; }
    .alumni-degree {
      font-size: 11px; font-weight: 500; letter-spacing: 0.8px;
      text-transform: uppercase; color: var(--ice-blue);
      margin-bottom: 0.3rem;
    }
    .alumni-thesis {
      font-size: 12.5px; color: var(--text-muted);
      font-style: italic; margin-bottom: 0.5rem;
      line-height: 1.5; display: -webkit-box;
      -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
    }
    .alumni-now {
      font-size: 12px; color: var(--text-body);
      display: flex; align-items: flex-start; gap: 5px;
    }
    .alumni-now::before { content: '→'; color: var(--ice-bright); flex-shrink: 0; }

    /* ── COLLAB SECTION ── */
    .collab-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
      gap: 1rem; margin-top: 1.5rem;
    }
    .collab-card {
      background: white; border: 1px solid var(--border);
      border-radius: 10px; padding: 1.2rem 1.5rem;
      transition: border-color 0.2s;
    }
    .collab-card:hover { border-color: var(--ice-blue); }
    .collab-name { font-weight: 500; font-size: 14px; color: var(--ice-deep); margin-bottom: 2px; }
    .collab-inst { font-size: 12px; color: var(--text-muted); margin-bottom: 0.4rem; }
    .collab-topic { font-size: 12px; color: var(--ice-blue); font-style: italic; }

    /* ── STATS BANNER ── */
    .stats-strip {
      background: var(--ice-mid);
      padding: 1.75rem 3rem;
      display: flex; justify-content: center; gap: 4rem;
      border-bottom: 1px solid rgba(91,184,232,0.1);
    }
    .stat-item { text-align: center; }
    .stat-num {
      font-family: 'Playfair Display', serif;
      font-size: 1.8rem; font-weight: 600; color: var(--ice-bright); display: block;
    }
    .stat-label {
      font-size: 11px; letter-spacing: 1.5px; text-transform: uppercase;
      color: rgba(255,255,255,0.45); font-weight: 400;
    }

    /* ── DIVIDER ── */
    .full-width-band { background: var(--ice-frost); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }

    /* ── COLLABORATORS MAP ── */
    #collabMap {
      height: 380px; border-radius: 12px; overflow: hidden;
      margin-top: 1.5rem; border: 1px solid var(--border);
      background: var(--ice-mid); /* shown briefly while tiles load */
    }
    .collab-pin {
      width: 16px; height: 16px; border-radius: 50%;
      background: var(--ice-bright);
      border: 2px solid white;
      box-shadow: 0 0 0 4px rgba(91,184,232,0.35), 0 2px 6px rgba(10,22,40,0.4);
    }
    .network-pin {
      width: 11px; height: 11px; border-radius: 50%;
      background: #e8b64d;
      border: 2px solid white;
      box-shadow: 0 0 0 3px rgba(232,182,77,0.35), 0 2px 6px rgba(10,22,40,0.4);
    }
    .leaflet-popup-content-wrapper { border-radius: 10px; }
    .leaflet-popup-content { font-family: 'DM Sans', sans-serif; margin: 0.8rem 1rem; }
    .collab-popup-name { font-weight: 500; font-size: 13px; color: var(--ice-deep); margin: 0 0 2px; }
    .collab-popup-inst { font-size: 11px; color: var(--text-muted); margin: 0 0 6px; }
    .collab-popup-topic { font-size: 11px; color: var(--ice-blue); font-style: italic; margin: 0; }
    .collab-popup-count { font-size: 11px; color: var(--text-muted); margin: 0; }
    .map-legend {
      display: flex; gap: 1.5rem; margin-top: 0.75rem; font-size: 12px; color: var(--text-muted);
    }
    .map-legend span { display: inline-flex; align-items: center; gap: 6px; }
    .map-legend .dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }
    .map-legend .dot.blue { background: var(--ice-bright); }
    .map-legend .dot.gold { background: #e8b64d; }
  
  
  
  
  
  
  
  </style>
</head>
